<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Description>Core models and interfaces for Social Media Commander with AI, advanced auth, MCP, and Windows integration</Description>
    <Authors>Social Media Commander Team</Authors>
    <Company>Social Media Commander</Company>
    <Product>Social Media Commander</Product>
    <Copyright>Copyright © 2024 Social Media Commander</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core dependencies -->
  <PackageReference Include="Serilog" />
  <PackageReference Include="Serilog.Sinks.Console" />
  <PackageReference Include="Serilog.Sinks.File" />
  <PackageReference Include="System.ComponentModel.Annotations" />
  <PackageReference Include="System.Text.Json" />
    
    <!-- Authentication and Security -->
  <PackageReference Include="System.Security.Claims" />
  <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    
    <!-- AI and ML -->
  <PackageReference Include="Microsoft.ML" />
  <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    
    <!-- Reactive Extensions -->
  <PackageReference Include="System.Reactive" />
    
    <!-- Configuration -->
  <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  <PackageReference Include="Microsoft.Extensions.Options" />
    
    <!-- Logging -->
  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    
    <!-- Validation -->
  <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
