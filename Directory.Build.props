<Project>
  
  <PropertyGroup>
    <!-- .NET targeting and common properties -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Application metadata -->
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Authors>Social Media Commander Team</Authors>
    <Company>Social Media Commander</Company>
    <Product>Social Media Commander</Product>
    <Copyright>Copyright © 2024 Social Media Commander</Copyright>
    
    <!-- Package management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    
    <!-- Build configuration -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors />
  </PropertyGroup>

  <!-- Automatic Git Hooks Setup Target -->
  <!-- Runs on first build to configure hooks automatically -->
  <Target Name="SetupGitHooks" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true' AND '$(BuildingInsideVisualStudio)' != 'true'">
    <PropertyGroup>
      <GitHooksPath>.githooks</GitHooksPath>
      <SetupScriptWindows>setup-hooks.ps1</SetupScriptWindows>
      <SetupScriptUnix>setup-hooks.sh</SetupScriptUnix>
    </PropertyGroup>
    
    <!-- Check if hooks are already configured -->
    <Exec Command="git config core.hooksPath" 
          ConsoleToMSBuild="true" 
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="CurrentHooksPath" />
      <Output TaskParameter="ExitCode" PropertyName="GitConfigExitCode" />
    </Exec>
    
    <!-- Configure hooks if not already set up -->
    <Exec Command="git config core.hooksPath $(GitHooksPath)" 
          Condition="'$(CurrentHooksPath)' != '$(GitHooksPath)'"
          IgnoreExitCode="false" />
    
    <!-- Log success message -->
    <Message Text="✅ Git hooks configured automatically at: $(GitHooksPath)" 
             Importance="high" 
             Condition="'$(CurrentHooksPath)' != '$(GitHooksPath)'" />
    
    <!-- Make hooks executable on Unix-like systems (always run if files exist) -->
    <Exec Command="test -f $(GitHooksPath)/pre-commit &amp;&amp; chmod +x $(GitHooksPath)/pre-commit || true" 
          Condition="'$(OS)' != 'Windows_NT'"
          IgnoreExitCode="true"
          ContinueOnError="true" />
    <Exec Command="test -f $(GitHooksPath)/post-commit &amp;&amp; chmod +x $(GitHooksPath)/post-commit || true" 
          Condition="'$(OS)' != 'Windows_NT'"
          IgnoreExitCode="true"
          ContinueOnError="true" />
  </Target>
  
</Project>