#!/bin/sh
#
# Pre-commit hook for Social Media Commander
# Enforces code quality, security, and build standards before allowing commits
#

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

# Function to print error messages
error() {
    echo "${RED}❌ ERROR: $1${NC}"
    ERRORS=$((ERRORS + 1))
}

# Function to print warning messages
warning() {
    echo "${YELLOW}⚠️  WARNING: $1${NC}"
    WARNINGS=$((WARNINGS + 1))
}

# Function to print success messages
success() {
    echo "${GREEN}✅ $1${NC}"
}

# 1. Check for secrets and sensitive data
echo ""
echo "🔐 Checking for secrets and sensitive data..."
SECRETS_FOUND=0

# Check for common secret patterns
if git diff --cached --name-only ':(exclude)*.md' | xargs grep -l "ClientSecret\s*=\s*['\"][^'\"]*[^_HERE]['\"]" 2>/dev/null; then
    error "Found hardcoded ClientSecret values. Use placeholders like 'YOUR_CLIENT_ID_HERE'"
    SECRETS_FOUND=1
fi

if git diff --cached --name-only ':(exclude)*.md' | xargs grep -l "ClientId\s*=\s*['\"][a-zA-Z0-9]\{32,\}['\"]" 2>/dev/null; then
    warning "Found potential real ClientId values. Ensure these are placeholders."
fi

# Check for API keys, passwords, tokens
if git diff --cached --name-only ':(exclude)*.md' | xargs grep -iE "(api[_-]?key|password|secret|token|private[_-]?key)\s*=\s*['\"][^'\"]{20,}['\"]" 2>/dev/null | grep -v "YOUR_.*_HERE" | grep -v "PLACEHOLDER" | grep -v "test" | grep -v ".sample"; then
    error "Found potential hardcoded credentials. Use placeholders or environment variables."
    SECRETS_FOUND=1
fi

if [ $SECRETS_FOUND -eq 0 ]; then
    success "No secrets detected"
fi

# 2. Check for package version violations (Central Package Management)
echo ""
echo "📦 Checking Central Package Management compliance..."
CPM_VIOLATIONS=0

# Check if any .csproj files have PackageReference with Version attribute
for file in $(git diff --cached --name-only | grep "\.csproj$"); do
    if [ -f "$file" ]; then
        if grep -q '<PackageReference.*Version=' "$file"; then
            error "File $file contains PackageReference with Version attribute. All versions must be in Directory.Packages.props"
            CPM_VIOLATIONS=1
        fi
    fi
done

if [ $CPM_VIOLATIONS -eq 0 ]; then
    success "Central Package Management compliance verified"
fi

# 3. Check for ConfigureAwait(false) in library code
echo ""
echo "⚡ Checking async/await best practices..."
ASYNC_VIOLATIONS=0

for file in $(git diff --cached --name-only | grep -E "\.cs$" | grep -E "(Core|Services)/"); do
    if [ -f "$file" ]; then
        # Check for await without ConfigureAwait in service/library code
        if git diff --cached "$file" | grep -E "^\+.*await\s+" | grep -v "ConfigureAwait" | grep -v "// No ConfigureAwait needed" | grep -v "ViewModel" > /dev/null; then
            warning "File $file contains 'await' without ConfigureAwait(false) in library code. This may cause deadlocks."
            ASYNC_VIOLATIONS=1
        fi
    fi
done

if [ $ASYNC_VIOLATIONS -eq 0 ]; then
    success "Async/await patterns verified"
fi

# 4. Check for nullable reference type violations
echo ""
echo "🔍 Checking nullable reference types..."
NULLABLE_VIOLATIONS=0

for file in $(git diff --cached --name-only | grep "\.cs$"); do
    if [ -f "$file" ]; then
        # Check for potential null assignments without proper handling
        if git diff --cached "$file" | grep -E "^\+.*=\s*null;" | grep -v "?" | grep -v "!" | grep -v "//" > /dev/null; then
            warning "File $file may contain nullable violations. Ensure nullable reference types are properly handled."
            NULLABLE_VIOLATIONS=1
        fi
    fi
done

if [ $NULLABLE_VIOLATIONS -eq 0 ]; then
    success "Nullable reference type patterns look good"
fi

# 5. Verify dotnet format (if staged files include C# files)
if git diff --cached --name-only | grep -q "\.cs$"; then
    echo ""
    echo "🎨 Running dotnet format check..."
    
    # Run dotnet format in verify mode
    if command -v dotnet > /dev/null 2>&1; then
        if ! dotnet format --verify-no-changes --verbosity quiet > /dev/null 2>&1; then
            warning "Code formatting issues detected. Run 'dotnet format' to fix."
            echo "  Hint: Run 'dotnet format' before committing."
        else
            success "Code formatting verified"
        fi
    else
        warning "dotnet CLI not found. Skipping format check."
    fi
fi

# 6. Run build check on staged C# files
if git diff --cached --name-only | grep -E "\.(cs|csproj)$" > /dev/null; then
    echo ""
    echo "🏗️  Running build verification..."
    
    if command -v dotnet > /dev/null 2>&1; then
        # Build the solution
        if dotnet build SocialMediaCommander.sln --nologo --verbosity quiet > /dev/null 2>&1; then
            success "Build verification passed"
        else
            error "Build failed. Fix build errors before committing."
            echo "  Run 'dotnet build SocialMediaCommander.sln' to see details."
        fi
    else
        warning "dotnet CLI not found. Skipping build check."
    fi
fi

# 7. Check for TODO/FIXME/HACK comments in new code
echo ""
echo "📝 Checking for code markers..."
MARKERS_FOUND=0

for file in $(git diff --cached --name-only | grep -E "\.(cs|ts|tsx)$"); do
    if [ -f "$file" ]; then
        if git diff --cached "$file" | grep -E "^\+.*\/\/.*\b(TODO|FIXME|HACK|XXX)\b" > /dev/null; then
            warning "File $file contains TODO/FIXME/HACK markers in new code"
            MARKERS_FOUND=1
        fi
    fi
done

if [ $MARKERS_FOUND -eq 0 ]; then
    success "No unresolved code markers in new code"
fi

# 8. Check for console.log in frontend code (should use proper logging)
if git diff --cached --name-only | grep -E "\.(ts|tsx|js|jsx)$" > /dev/null; then
    echo ""
    echo "🖥️  Checking frontend logging practices..."
    CONSOLE_LOG_FOUND=0
    
    for file in $(git diff --cached --name-only | grep -E "\.(ts|tsx|js|jsx)$"); do
        if [ -f "$file" ]; then
            if git diff --cached "$file" | grep -E "^\+.*console\.(log|debug)" > /dev/null; then
                warning "File $file contains console.log/debug. Consider using proper logging."
                CONSOLE_LOG_FOUND=1
            fi
        fi
    done
    
    if [ $CONSOLE_LOG_FOUND -eq 0 ]; then
        success "Frontend logging practices verified"
    fi
fi

# 9. Ensure test files aren't accidentally included if disabled
echo ""
echo "🧪 Checking test file conventions..."
TEST_ISSUES=0

for file in $(git diff --cached --name-only | grep "Tests.*\.cs$" | grep "\.disabled$"); do
    if [ -f "$file" ]; then
        warning "Committing disabled test file: $file. Ensure this is intentional."
        TEST_ISSUES=1
    fi
done

if [ $TEST_ISSUES -eq 0 ]; then
    success "Test file conventions verified"
fi

# 10. Check for large files (>1MB)
echo ""
echo "📏 Checking file sizes..."
LARGE_FILES=0

for file in $(git diff --cached --name-only); do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file")
        if [ $size -gt 1048576 ]; then
            warning "Large file detected: $file ($(($size / 1024))KB). Consider if this should be tracked."
            LARGE_FILES=1
        fi
    fi
done

if [ $LARGE_FILES -eq 0 ]; then
    success "No large files detected"
fi

# Summary
echo ""
echo "================================"
if [ $ERRORS -gt 0 ]; then
    echo "${RED}❌ Pre-commit checks FAILED with $ERRORS error(s) and $WARNINGS warning(s)${NC}"
    echo ""
    echo "Fix the errors above before committing."
    echo "To bypass these checks (not recommended), use: git commit --no-verify"
    exit 1
else
    if [ $WARNINGS -gt 0 ]; then
        echo "${YELLOW}⚠️  Pre-commit checks PASSED with $WARNINGS warning(s)${NC}"
    else
        echo "${GREEN}✅ All pre-commit checks PASSED!${NC}"
    fi
    echo ""
    echo "Proceeding with commit..."
    exit 0
fi
