<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Enhanced services for Social Media Commander with AI, advanced auth, MCP, and Windows integration</Description>
    
    <!-- AOT Compatibility -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialMediaCommander.Core\SocialMediaCommander.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTTP and Web -->
    <PackageReference Include="idunno.Bluesky" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    
    <!-- AI and LLM Integration -->
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    
    <!-- Advanced Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="IdentityModel" />
    <PackageReference Include="System.Security.Cryptography.Algorithms" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Otp.NET" />
    
    <!-- MCP (Model Context Protocol) -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="System.IO.Pipelines" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    
    <!-- Windows Integration -->
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Microsoft.Win32.Registry" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="Microsoft.Windows.Compatibility" />
    <PackageReference Include="System.Management.Automation" />
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="TaskScheduler" />
    
    <!-- Reactive Extensions and Observables -->
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="System.Reactive.Linq" />
    
    <!-- Caching and Memory -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    
    <!-- Configuration and Options -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    
    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    
    <!-- Validation and Serialization -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Newtonsoft.Json" />
    
    <!-- Markdown Processing -->
    <PackageReference Include="Markdig.Signed" />
    
    <!-- Background Services -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.MemoryStorage" />
    
    <!-- Database (for advanced features) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    
    <!-- Security -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" />
    
    <!-- Testing utilities -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Moq" />
  </ItemGroup>

</Project>
