<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="SocialMediaCommander.Desktop.Views.SocialFeedView"
             x:DataType="vm:SocialFeedViewModel">

    <Border Background="{DynamicResource SMC-Card-Background}" 
            BorderBrush="{DynamicResource SMC-Card-Border}" 
            BorderThickness="1" 
            CornerRadius="12">
        
        <Grid RowDefinitions="Auto, Auto, *">
            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,20,20,12" ColumnDefinitions="*,Auto">
                <TextBlock Text="Social Feeds" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🔄 Refresh" Classes="ghost" IsEnabled="{Binding !IsRefreshing}"/>
            </Grid>

            <!-- Platform Filters -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="20,0,20,12">
                <ItemsControl ItemsSource="{Binding PlatformFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Classes="outline" Padding="12,6"
                                    Command="{Binding $parent[UserControl].((vm:SocialFeedViewModel)DataContext).FilterByPlatformCommand}"
                                    CommandParameter="{Binding Id}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Feed Content -->
            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="16" Margin="20,0,20,20">
                    <!-- Loading State -->
                    <StackPanel IsVisible="{Binding IsLoading}" Spacing="12" MinHeight="300" 
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="100"/>
                        <TextBlock Text="Loading social feeds..." Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Empty State -->
                     <StackPanel IsVisible="{Binding !HasFeedItems}" Spacing="12" MinHeight="300"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="No posts to show" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Posts from connected accounts will appear here" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Feed Items -->
                    <ItemsControl ItemsSource="{Binding FeedPosts}" IsVisible="{Binding HasFeedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SMC-Card-Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="8">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="Gray" Margin="0,0,12,0">
                                                <!-- Placeholder for Avatar -->
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TimeAgo}" FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding PlatformDisplayName}" FontSize="12" Opacity="0.7"/>
                                        </Grid>
                                        <!-- Content -->
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                        <!-- Media Placeholder (if any) -->
                                        <Border IsVisible="{Binding HasMedia}" Background="#F0F0F0" Height="100" CornerRadius="4">
                                            <TextBlock Text="[Media Content]" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl> 