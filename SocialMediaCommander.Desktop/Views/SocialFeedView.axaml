<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             xmlns:models="using:SocialMediaCommander.Core.Models"
             x:Class="SocialMediaCommander.Desktop.Views.SocialFeedView"
             x:DataType="vm:SocialFeedViewModel">

  <Border Background="White" 
          CornerRadius="8" 
          Padding="0"
          BoxShadow="0 1 3 0 rgba(0, 0, 0, 0.1)">
    
    <Grid RowDefinitions="Auto,Auto,*">
      
      <!-- Header -->
      <Grid Grid.Row="0" Margin="20,20,20,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0" 
                   Text="Feeds" 
                   FontSize="16" 
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
      </Grid>
      
      <!-- Social Feeds Header -->
      <Grid Grid.Row="1" Margin="20,0,20,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0" 
                   Text="Social Feeds" 
                   FontSize="20" 
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        
        <Button Grid.Column="1" 
                Command="{Binding RefreshFeedCommand}"
                Background="Transparent"
                Foreground="#6B7280"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Padding="12,6"
                CornerRadius="6"
                FontSize="14">
          <TextBlock Text="🔄 Refresh"/>
        </Button>
      </Grid>
      
      <!-- Platform Tabs and Feed Content -->
      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Platform Tabs -->
        <Border Grid.Row="0" 
                Background="#F8FAFC" 
                Padding="20,0,20,0"
                BorderThickness="0,1,0,1"
                BorderBrush="#E5E7EB">
          <StackPanel Orientation="Horizontal" 
                     HorizontalAlignment="Center"
                     Spacing="0">
            
            <!-- BlueSky Tab -->
            <Button Content="BlueSky" 
                    Background="#0085FF"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="16,8"
                    CornerRadius="0"
                    FontSize="14"
                    FontWeight="Medium"/>
            
            <!-- X Tab -->
            <Button Content="X" 
                    Background="Transparent"
                    Foreground="#6B7280"
                    BorderThickness="0"
                    Padding="16,8"
                    CornerRadius="0"
                    FontSize="14"/>
            
            <!-- LinkedIn Tab -->
            <Button Content="LinkedIn" 
                    Background="Transparent"
                    Foreground="#6B7280"
                    BorderThickness="0"
                    Padding="16,8"
                    CornerRadius="0"
                    FontSize="14"/>
            
            <!-- Threads Tab -->
            <Button Content="Threads" 
                    Background="Transparent"
                    Foreground="#6B7280"
                    BorderThickness="0"
                    Padding="16,8"
                    CornerRadius="0"
                    FontSize="14"/>
            
            <!-- Facebook Tab -->
            <Button Content="Facebook" 
                    Background="Transparent"
                    Foreground="#6B7280"
                    BorderThickness="0"
                    Padding="16,8"
                    CornerRadius="0"
                    FontSize="14"/>
          </StackPanel>
        </Border>
        
        <!-- Feed Content -->
        <ScrollViewer Grid.Row="1" 
                     Padding="20"
                     MaxHeight="600">
          
          <Grid>
            <!-- Loading State -->
            <StackPanel IsVisible="{Binding IsLoading}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Spacing="12">
              <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center"/>
              <TextBlock Text="Loading posts..." 
                        FontSize="14" 
                        Foreground="#6B7280"
                        HorizontalAlignment="Center"/>
            </StackPanel>
            
            <!-- Feed Items -->
            <StackPanel IsVisible="{Binding !IsLoading}" Spacing="16">
            
            <!-- Sample Feed Item 1 -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              
              <StackPanel Spacing="12">
                
                <!-- User Info -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  
                  <!-- Avatar -->
                  <Border Grid.Column="0" 
                          Width="40" 
                          Height="40" 
                          CornerRadius="20"
                          Background="#0085FF"
                          Margin="0,0,12,0">
                    <TextBlock Text="BU" 
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  
                  <!-- User Details -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      
                      <TextBlock Grid.Column="0" 
                                Text="BlueSky User 1" 
                                FontWeight="SemiBold"
                                FontSize="14"
                                Margin="0,0,8,0"/>
                      
                      <TextBlock Grid.Column="1" 
                                Text="@user1" 
                                FontSize="14"
                                Foreground="#6B7280"/>
                    </Grid>
                    
                    <TextBlock Text="4h 56m ago" 
                              FontSize="12"
                              Foreground="#6B7280"
                              Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
                
                <!-- Post Content -->
                <TextBlock Text="Latest updates from the world of tech! #technology #innovation"
                          FontSize="14"
                          TextWrapping="Wrap"
                          LineHeight="20"/>
                
                <!-- Interaction Buttons -->
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  
                  <!-- Comments -->
                  <Button Grid.Column="0" 
                          Content="💬 12" 
                          Background="Transparent"
                          Foreground="#6B7280"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"
                          Margin="0,0,16,0"/>
                  
                  <!-- Reposts -->
                  <Button Grid.Column="1" 
                          Content="🔄 8" 
                          Background="Transparent"
                          Foreground="#6B7280"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"
                          Margin="0,0,16,0"/>
                  
                  <!-- Likes -->
                  <Button Grid.Column="2" 
                          Content="❤️ 45" 
                          Background="Transparent"
                          Foreground="#EF4444"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"/>
                </Grid>
              </StackPanel>
            </Border>
            
            <!-- Sample Feed Item 2 -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              
              <StackPanel Spacing="12">
                
                <!-- User Info -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  
                  <!-- Avatar -->
                  <Border Grid.Column="0" 
                          Width="40" 
                          Height="40" 
                          CornerRadius="20"
                          Background="#0085FF"
                          Margin="0,0,12,0">
                    <TextBlock Text="BU" 
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  
                  <!-- User Details -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      
                      <TextBlock Grid.Column="0" 
                                Text="BlueSky User 2" 
                                FontWeight="SemiBold"
                                FontSize="14"
                                Margin="0,0,8,0"/>
                      
                      <TextBlock Grid.Column="1" 
                                Text="@user2" 
                                FontSize="14"
                                Foreground="#6B7280"/>
                    </Grid>
                    
                    <TextBlock Text="2h 23m ago" 
                              FontSize="12"
                              Foreground="#6B7280"
                              Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
                
                <!-- Post Content -->
                <TextBlock Text="Just shared my thoughts on sustainable business practices. Check out my latest article!"
                          FontSize="14"
                          TextWrapping="Wrap"
                          LineHeight="20"/>
                
                <!-- Interaction Buttons -->
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  
                  <!-- Comments -->
                  <Button Grid.Column="0" 
                          Content="💬 7" 
                          Background="Transparent"
                          Foreground="#6B7280"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"
                          Margin="0,0,16,0"/>
                  
                  <!-- Reposts -->
                  <Button Grid.Column="1" 
                          Content="🔄 3" 
                          Background="Transparent"
                          Foreground="#6B7280"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"
                          Margin="0,0,16,0"/>
                  
                  <!-- Likes -->
                  <Button Grid.Column="2" 
                          Content="🤍 18" 
                          Background="Transparent"
                          Foreground="#6B7280"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"/>
                </Grid>
              </StackPanel>
            </Border>
            
            <!-- Sample Feed Item 3 -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              
              <StackPanel Spacing="12">
                
                <!-- User Info -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  
                  <!-- Avatar -->
                  <Border Grid.Column="0" 
                          Width="40" 
                          Height="40" 
                          CornerRadius="20"
                          Background="#0085FF"
                          Margin="0,0,12,0">
                    <TextBlock Text="BU" 
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  
                  <!-- User Details -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      
                      <TextBlock Grid.Column="0" 
                                Text="BlueSky User 3" 
                                FontWeight="SemiBold"
                                FontSize="14"
                                Margin="0,0,8,0"/>
                      
                      <TextBlock Grid.Column="1" 
                                Text="@user3" 
                                FontSize="14"
                                Foreground="#6B7280"/>
                    </Grid>
                    
                    <TextBlock Text="1h 15m ago" 
                              FontSize="12"
                              Foreground="#6B7280"
                              Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
                
                <!-- Post Content -->
                <TextBlock Text="Amazing day at the conference! Met so many inspiring people. #networking"
                          FontSize="14"
                          TextWrapping="Wrap"
                          LineHeight="20"/>
                
                <!-- Interaction Buttons -->
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  
                  <!-- Comments -->
                  <Button Grid.Column="0" 
                          Content="💬 15" 
                          Background="Transparent"
                          Foreground="#6B7280"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"
                          Margin="0,0,16,0"/>
                  
                  <!-- Reposts -->
                  <Button Grid.Column="1" 
                          Content="🔄 12" 
                          Background="Transparent"
                          Foreground="#10B981"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"
                          Margin="0,0,16,0"/>
                  
                  <!-- Likes -->
                  <Button Grid.Column="2" 
                          Content="❤️ 67" 
                          Background="Transparent"
                          Foreground="#EF4444"
                          BorderThickness="0"
                          Padding="8,4"
                          FontSize="12"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</UserControl> 