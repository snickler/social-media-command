<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SocialMediaCommander.Desktop.Views.AnalyticsDashboardView"
             x:DataType="vm:AnalyticsDashboardViewModel">

    <Design.DataContext>
        <vm:AnalyticsDashboardViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*">
            
            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📊 Analytics Dashboard" 
                              FontSize="28" 
                              FontWeight="Bold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="Track your social media performance and engagement metrics" 
                              FontSize="16"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <!-- Time Range Selector -->
                    <ComboBox ItemsSource="{Binding TimeRangeOptions}"
                             SelectedItem="{Binding SelectedTimeRange}"
                             MinWidth="150"
                             VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Refresh Button -->
                    <Button Content="🔄 Refresh" 
                           Command="{Binding RefreshDataCommand}"
                           Classes="primary"
                           IsEnabled="{Binding !IsLoading}"/>
                    
                    <!-- Export Button -->
                    <Button Content="📈 Export" 
                           Command="{Binding ExportDataCommand}"
                           Classes="outline"/>
                </StackPanel>
            </Grid>
            
            <!-- Key Metrics Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Total Posts Card -->
                <Border Grid.Column="0" 
                       Classes="card interactive"
                       Padding="24,20"
                       Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="📝" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalPosts}" 
                                  FontSize="32" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Total Posts" 
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Engagement Card -->
                <Border Grid.Column="1" 
                       Classes="card interactive"
                       Padding="24,20"
                       Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="❤️" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalEngagementFormatted}" 
                                  FontSize="32" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Total Engagement" 
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Engagement Rate Card -->
                <Border Grid.Column="2" 
                       Classes="card interactive"
                       Padding="24,20"
                       Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="📊" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding EngagementRateFormatted}" 
                                  FontSize="32" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Engagement Rate" 
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Reach Card -->
                <Border Grid.Column="3" 
                       Classes="card interactive"
                       Padding="24,20"
                       Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="👥" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalReachFormatted}" 
                                  FontSize="32" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Total Reach" 
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Growth Rate Card -->
                <Border Grid.Column="4" 
                       Classes="card interactive"
                       Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="📈" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding GrowthRateFormatted}" 
                                  FontSize="32" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Growth Rate" 
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Charts and Insights Section -->
            <Grid Grid.Row="2" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Engagement Chart -->
                <Border Grid.Column="0" 
                       Background="White" 
                       CornerRadius="12" 
                       Padding="24"
                       BoxShadow="0 1 3 0 #19000000">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Engagement Over Time" 
                                          FontSize="18" 
                                          FontWeight="SemiBold"
                                          Foreground="#1F2937"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Daily engagement metrics for the selected period" 
                                          FontSize="14"
                                          Foreground="#6B7280"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" Background="#4F46E5" CornerRadius="2"/>
                                    <TextBlock Text="Engagement" FontSize="12" Foreground="#6B7280"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" Background="#10B981" CornerRadius="2"/>
                                    <TextBlock Text="Reach" FontSize="12" Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Simplified Chart Representation -->
                        <Border Height="200" 
                               Background="#F9FAFB" 
                               CornerRadius="8"
                               Padding="20">
                            <Grid>
                                <TextBlock Text="📊 Chart visualization would be rendered here" 
                                          FontSize="16"
                                          Foreground="#6B7280"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="(Integration with charting library like OxyPlot)" 
                                          FontSize="12"
                                          Foreground="#9CA3AF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,10"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Insights Panel -->
                <Border Grid.Column="2" 
                       Background="White" 
                       CornerRadius="12" 
                       Padding="24"
                       BoxShadow="0 1 3 0 #19000000">
                    <StackPanel>
                        <TextBlock Text="📈 Key Insights" 
                                  FontSize="18" 
                                  FontWeight="SemiBold"
                                  Foreground="#1F2937"
                                  Margin="0,0,0,20"/>
                        
                        <!-- Best Posting Time -->
                        <Border Background="#EFF6FF" 
                               CornerRadius="8" 
                               Padding="16"
                               Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⏰ Best Posting Time" 
                                          FontSize="14" 
                                          FontWeight="Medium"
                                          Foreground="#1E40AF"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding BestPostingTime}" 
                                          FontSize="20" 
                                          FontWeight="Bold"
                                          Foreground="#1E40AF"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Top Platform -->
                        <Border Background="#ECFDF5" 
                               CornerRadius="8" 
                               Padding="16"
                               Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🏆 Top Platform" 
                                          FontSize="14" 
                                          FontWeight="Medium"
                                          Foreground="#065F46"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TopPerformingPlatform}" 
                                          FontSize="20" 
                                          FontWeight="Bold"
                                          Foreground="#065F46"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- New Followers -->
                        <Border Background="#FEF3C7" 
                               CornerRadius="8" 
                               Padding="16">
                            <StackPanel>
                                <TextBlock Text="👥 New Followers" 
                                          FontSize="14" 
                                          FontWeight="Medium"
                                          Foreground="#92400E"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding NewFollowersFormatted}" 
                                          FontSize="20" 
                                          FontWeight="Bold"
                                          Foreground="#92400E"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Platform Performance and Top Posts -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Platform Performance -->
                <Border Grid.Column="0" 
                       Background="White" 
                       CornerRadius="12" 
                       Padding="24"
                       BoxShadow="0 1 3 0 #19000000">
                    <StackPanel>
                        <TextBlock Text="🚀 Platform Performance" 
                                  FontSize="18" 
                                  FontWeight="SemiBold"
                                  Foreground="#1F2937"
                                  Margin="0,0,0,20"/>
                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                            <ItemsControl ItemsSource="{Binding PlatformMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" 
                                               CornerRadius="8" 
                                               Padding="16"
                                               Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Platform Icon -->
                                                <Border Grid.Column="0" 
                                                       Width="40" Height="40"
                                                       Background="{Binding PlatformColor}"
                                                       CornerRadius="8"
                                                       Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding PlatformIcon}" 
                                                              FontSize="20"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <!-- Platform Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PlatformName}" 
                                                              FontSize="16" 
                                                              FontWeight="SemiBold"
                                                              Foreground="#1F2937"
                                                              Margin="0,0,0,4"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="📝" FontSize="12"/>
                                                            <TextBlock Text="{Binding PostCount}" 
                                                                      FontSize="12" 
                                                                      Foreground="#6B7280"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="❤️" FontSize="12"/>
                                                            <TextBlock Text="{Binding TotalEngagementFormatted}" 
                                                                      FontSize="12" 
                                                                      Foreground="#6B7280"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="👥" FontSize="12"/>
                                                            <TextBlock Text="{Binding TotalReachFormatted}" 
                                                                      FontSize="12" 
                                                                      Foreground="#6B7280"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <!-- Metrics -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding EngagementRateFormatted}" 
                                                              FontSize="16" 
                                                              FontWeight="Bold"
                                                              Foreground="#059669"
                                                              HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding FollowerGrowthFormatted}" 
                                                              FontSize="12" 
                                                              Foreground="#6B7280"
                                                              HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
                <!-- Top Posts -->
                <Border Grid.Column="2" 
                       Background="White" 
                       CornerRadius="12" 
                       Padding="24"
                       BoxShadow="0 1 3 0 #19000000">
                    <StackPanel>
                        <TextBlock Text="🌟 Top Performing Posts" 
                                  FontSize="18" 
                                  FontWeight="SemiBold"
                                  Foreground="#1F2937"
                                  Margin="0,0,0,20"/>
                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                            <ItemsControl ItemsSource="{Binding TopPosts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" 
                                               CornerRadius="8" 
                                               Padding="16"
                                               Margin="0,0,0,12"
                                               Cursor="Hand">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding Platform}" 
                                                              FontSize="12" 
                                                              FontWeight="Medium"
                                                              Foreground="#4F46E5"/>
                                                    
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding PostedDateFormatted}" 
                                                              FontSize="12" 
                                                              Foreground="#6B7280"/>
                                                </Grid>
                                                
                                                <TextBlock Text="{Binding Content}" 
                                                          FontSize="14" 
                                                          TextWrapping="Wrap"
                                                          Foreground="#1F2937"
                                                          Margin="0,0,0,12"
                                                          MaxLines="3"/>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="❤️" FontSize="12"/>
                                                        <TextBlock Text="{Binding Likes}" FontSize="12" Foreground="#6B7280"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="💬" FontSize="12"/>
                                                        <TextBlock Text="{Binding Comments}" FontSize="12" Foreground="#6B7280"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="🔄" FontSize="12"/>
                                                        <TextBlock Text="{Binding Shares}" FontSize="12" Foreground="#6B7280"/>
                                                    </StackPanel>
                                                    
                                                    <TextBlock Grid.Column="3"
                                                              Text="{Binding TotalEngagementFormatted}" 
                                                              FontSize="14" 
                                                              FontWeight="Bold"
                                                              Foreground="#059669"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Loading Overlay -->
            <Border Grid.RowSpan="4" 
                   Background="#80FFFFFF" 
                   IsVisible="{Binding IsLoading}"
                   CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Spacing="16">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Loading analytics data..." 
                              FontSize="16"
                              Foreground="#6B7280"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl> 