<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             xmlns:models="using:SocialMediaCommander.Core.Models"
             xmlns:converters="using:SocialMediaCommander.Desktop.Converters"
             x:Class="SocialMediaCommander.Desktop.Views.MediaUploadView"
             x:DataType="vm:MediaUploadViewModel">

  <Design.DataContext>
    <vm:MediaUploadViewModel/>
  </Design.DataContext>

  <Border Background="White" 
          CornerRadius="8" 
          Padding="20"
          BorderBrush="#E5E7EB"
          BorderThickness="1">
    
    <StackPanel Spacing="16">
      
      <!-- Header -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0">
          <TextBlock Text="Media" 
                    FontSize="16" 
                    FontWeight="SemiBold"
                    Margin="0,0,0,4"/>
          <TextBlock Text="Add up to 4 images or videos to your post" 
                    FontSize="12"
                    Foreground="#6B7280"/>
        </StackPanel>
        
        <Button Grid.Column="1"
               Content="📁 Upload"
               Command="{Binding UploadCommand}"
               Background="#4F46E5"
               Foreground="White"
               Padding="12,8"
               CornerRadius="6"
               FontWeight="Medium"/>
      </Grid>
      
      <!-- Media Grid or Drop Area -->
      <Border Name="DropArea"
              Background="#F9FAFB"
              BorderBrush="#E5E7EB"
              BorderThickness="2"
              CornerRadius="8"
              MinHeight="200"
              IsVisible="{Binding !HasMedia}">
        <StackPanel HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Spacing="12">
          <TextBlock Text="📁 📹" 
                    FontSize="32"
                    HorizontalAlignment="Center"/>
          <TextBlock Text="Drag and drop media here or click to browse" 
                    FontSize="14"
                    Foreground="#6B7280"
                    HorizontalAlignment="Center"/>
          <TextBlock Text="Supports images and videos (JPG, PNG, MP4, MOV)" 
                    FontSize="12"
                    Foreground="#9CA3AF"
                    HorizontalAlignment="Center"/>
          <Button Content="📁 Choose Files"
                 Command="{Binding UploadCommand}"
                 Background="#4F46E5"
                 Foreground="White"
                 Padding="16,10"
                 CornerRadius="6"
                 Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      
      <!-- Media Items Grid -->
      <Grid IsVisible="{Binding HasMedia}">
        <ItemsControl ItemsSource="{Binding MediaItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" Rows="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:Media">
              <Border Background="White"
                     BorderBrush="#E5E7EB"
                     BorderThickness="1"
                     CornerRadius="8"
                     Margin="4"
                     MinHeight="120">
                
                <Grid>
                  <!-- Media Type Icon -->
                  <Border Background="#F3F4F6"
                         CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Spacing="8">
                      
                      <TextBlock Text="{Binding Type, Converter={x:Static converters:MediaTypeToIconConverter.Instance}}" 
                                FontSize="24"
                                HorizontalAlignment="Center"/>
                      
                      <TextBlock Text="{Binding FileName}" 
                                FontSize="12"
                                FontWeight="Medium"
                                HorizontalAlignment="Center"
                                MaxWidth="100"
                                TextTrimming="CharacterEllipsis"/>
                      
                      <TextBlock Text="{Binding FileSizeFormatted}" 
                                FontSize="10"
                                Foreground="#6B7280"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  
                  <!-- Remove Button -->
                  <Button HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Width="24" Height="24"
                         Margin="8"
                         Content="❌"
                         FontSize="10"
                         Background="#EF4444"
                         Foreground="White"
                         CornerRadius="12"
                         Padding="0"
                         Command="{Binding $parent[UserControl].((vm:MediaUploadViewModel)DataContext).RemoveMediaCommand}"
                         CommandParameter="{Binding}"/>
                  
                  <!-- Media Type Badge -->
                  <Border HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Background="#1F2937"
                         CornerRadius="4"
                         Padding="6,2"
                         Margin="8">
                    <TextBlock Text="{Binding Type}" 
                              FontSize="10"
                              Foreground="White"
                              FontWeight="Medium"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      
      <!-- Add More Button (when has media but not full) -->
      <Button Content="➕ Add More Media"
             Command="{Binding UploadCommand}"
             Background="Transparent"
             BorderBrush="#E5E7EB"
             BorderThickness="2"
             Padding="12,8"
             CornerRadius="6"
             FontWeight="Medium"
             IsVisible="{Binding CanAddMore}"
             HorizontalAlignment="Center"/>
      
      <!-- Media Count Info -->
      <TextBlock Text="{Binding MediaCountText}" 
                FontSize="12"
                Foreground="#6B7280"
                HorizontalAlignment="Center"
                IsVisible="{Binding HasMedia}"/>
      
    </StackPanel>
  </Border>
</UserControl> 