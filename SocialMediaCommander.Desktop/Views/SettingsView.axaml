<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SocialMediaCommander.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="200,*">
        <!-- Settings Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SMC-Muted}"
                BorderBrush="{DynamicResource SMC-Card-Border}"
                BorderThickness="0,0,1,0"
                Padding="12">
            <StackPanel Spacing="8">
                <!-- Back Button -->
                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseSettingsCommand}" 
                        Classes="ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Height="40"
                        Margin="0,0,0,12"
                        ToolTip.Tip="Back to Home">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="←" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Back" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Separator Margin="0,4"/>
                
                <!-- Navigation Items -->
                <TextBlock Text="SETTINGS" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource SMC-Muted-Foreground}"
                           Margin="8,8,0,4"/>
                
                <Button Classes="ghost"
                        Command="{Binding NavigateToSectionCommand}"
                        CommandParameter="Appearance"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🎨" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Appearance" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="ghost"
                        Command="{Binding NavigateToSectionCommand}"
                        CommandParameter="Notifications"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🔔" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Notifications" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="ghost"
                        Command="{Binding NavigateToSectionCommand}"
                        CommandParameter="Automation"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🤖" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Automation" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="ghost"
                        Command="{Binding NavigateToSectionCommand}"
                        CommandParameter="Privacy"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Privacy" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="ghost"
                        Command="{Binding NavigateToSectionCommand}"
                        CommandParameter="Platforms"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Platforms" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="ghost"
                        Command="{Binding NavigateToSectionCommand}"
                        CommandParameter="Media"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Media" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="ghost"
                        Command="{Binding NavigateToSectionCommand}"
                        CommandParameter="System"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💻" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="System" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Settings Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel Spacing="24" MaxWidth="800">
                <!-- Page Header -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource SMC-Foreground}"/>
                    <TextBlock Text="Customize the look and feel of your workspace" 
                               FontSize="14" 
                               Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                </StackPanel>
                
                <!-- Status Message -->
                <Border Background="{DynamicResource SMC-Success-Background}" 
                        BorderBrush="{DynamicResource SMC-Success-Border}" 
                        BorderThickness="1"
                        CornerRadius="8" 
                        Padding="12"
                        IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SMC-Success-Foreground}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium" Foreground="{DynamicResource SMC-Success-Foreground}"/>
                    </StackPanel>
                </Border>

                <!-- Appearance Section -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Appearance}">
                    <!-- Theme Settings -->
                    <Border Background="{DynamicResource SMC-Card-Background}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Theme &amp; Appearance" FontSize="16" FontWeight="SemiBold"/>
                                    
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="Theme:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" 
                                                    ItemsSource="{Binding ThemeOptions}"
                                                    SelectedItem="{Binding SelectedTheme}"
                                                    MinWidth="200" HorizontalAlignment="Left"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="Language:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" 
                                                    ItemsSource="{Binding LanguageOptions}"
                                                    SelectedItem="{Binding SelectedLanguage}"
                                                    MinWidth="200" HorizontalAlignment="Left"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="UI Scale:" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                <Slider Value="{Binding UiScale}" Minimum="0.8" Maximum="1.5" 
                                                      Width="200" TickFrequency="0.1"/>
                                                <TextBlock Text="{Binding UiScale, StringFormat='{}{0:P0}'}" 
                                                         VerticalAlignment="Center" MinWidth="50"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="Dark Mode:" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsDarkMode}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                </StackPanel>
                    
                <!-- Notifications Section -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Notifications}">
                    <!-- Notification Settings -->
                    <Border Background="{DynamicResource SMC-Card-Background}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Notification Preferences" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Content="Test" Command="{Binding TestNotificationsCommand}"
                                              Classes="secondary" Padding="6,3"
                                              CornerRadius="4" FontSize="11" ToolTip.Tip="Send a test notification"/>
                                    </StackPanel>
                                    
                                    <StackPanel Spacing="12">
                                        <CheckBox Content="Enable Notifications" 
                                                IsChecked="{Binding EnableNotifications}"/>
                                        
                                        <CheckBox Content="Sound Notifications" 
                                                IsChecked="{Binding EnableSoundNotifications}"/>
                                        
                                        <CheckBox Content="Desktop Notifications" 
                                                IsChecked="{Binding EnableDesktopNotifications}"/>
                                        
                                        <CheckBox Content="Email Notifications" 
                                                IsChecked="{Binding EnableEmailNotifications}"/>
                                        
                                        <Grid ColumnDefinitions="200,*">
                                            <TextBlock Grid.Column="0" Text="Duration (seconds):" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" 
                                                    ItemsSource="{Binding NotificationDurationOptions}"
                                                    SelectedItem="{Binding NotificationDuration}"
                                                    MinWidth="150" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                </StackPanel>
                    
                <!-- Automation Section -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Automation}">
                    <!-- Automation Settings -->
                    <Border Background="{DynamicResource SMC-Card-Background}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Automation &amp; Scheduling" FontSize="16" FontWeight="SemiBold"/>
                                    
                                    <StackPanel Spacing="10">
                                        <CheckBox Content="Enable Auto Scheduling" 
                                                IsChecked="{Binding EnableAutoScheduling}"/>
                                        
                                        <CheckBox Content="Smart Posting" 
                                                IsChecked="{Binding EnableSmartPosting}"/>
                                        
                                        <CheckBox Content="Weekend Posting" 
                                                IsChecked="{Binding EnableWeekendPosting}"/>
                                        
                                        <Grid ColumnDefinitions="200,*">
                                            <TextBlock Grid.Column="0" Text="Schedule Interval (min):" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" 
                                                    ItemsSource="{Binding ScheduleIntervalOptions}"
                                                    SelectedItem="{Binding DefaultScheduleInterval}"
                                                    MinWidth="150" HorizontalAlignment="Left"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="200,*">
                                            <TextBlock Grid.Column="0" Text="Timezone:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" 
                                                    ItemsSource="{Binding TimezoneOptions}"
                                                    SelectedItem="{Binding TimezoneSelection}"
                                                    MinWidth="150" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                </StackPanel>
                    
                <!-- Privacy Section -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Privacy}">
                    <!-- Privacy Settings -->
                    <Border Background="{DynamicResource SMC-Card-Background}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Privacy &amp; Security" FontSize="16" FontWeight="SemiBold"/>
                                    
                                    <StackPanel Spacing="10">
                                        <CheckBox Content="Enable Analytics" 
                                                IsChecked="{Binding EnableAnalytics}"/>
                                        
                                        <CheckBox Content="Crash Reporting" 
                                                IsChecked="{Binding EnableCrashReporting}"/>
                                        
                                        <CheckBox Content="Auto Save" 
                                                IsChecked="{Binding EnableAutoSave}"/>
                                        
                                        <CheckBox Content="Enable Encryption" 
                                                IsChecked="{Binding EnableEncryption}"/>
                                        
                                        <Grid ColumnDefinitions="200,*">
                                            <TextBlock Grid.Column="0" Text="Auto Save Interval (min):" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" 
                                                    ItemsSource="{Binding AutoSaveIntervalOptions}"
                                                    SelectedItem="{Binding AutoSaveInterval}"
                                                    MinWidth="150" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                </StackPanel>
                    
                <!-- Platforms Section -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Platforms}">
                    <!-- Platform Integration Settings -->
                    <Border Background="{DynamicResource SMC-Card-Background}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Platform Integrations" FontSize="16" FontWeight="SemiBold"/>
                                    
                                    <StackPanel Spacing="10">
                                        <CheckBox Content="Twitter Integration" 
                                                IsChecked="{Binding EnableTwitterIntegration}"/>
                                        
                                        <CheckBox Content="Facebook Integration" 
                                                IsChecked="{Binding EnableFacebookIntegration}"/>
                                        
                                        <CheckBox Content="Instagram Integration" 
                                                IsChecked="{Binding EnableInstagramIntegration}"/>
                                        
                                        <CheckBox Content="LinkedIn Integration" 
                                                IsChecked="{Binding EnableLinkedInIntegration}"/>
                                        
                                        <CheckBox Content="TikTok Integration" 
                                                IsChecked="{Binding EnableTikTokIntegration}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                </StackPanel>
                    
                <!-- Media Section -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Media}">
                    <!-- Media Settings -->
                    <Border Background="{DynamicResource SMC-Card-Background}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Media &amp; Storage" FontSize="16" FontWeight="SemiBold"/>
                                    
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="200,*">
                                            <TextBlock Grid.Column="0" Text="Default Folder:" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                <TextBox Text="{Binding DefaultMediaFolder}" Width="300" IsReadOnly="True"/>
                                                <Button Content="Browse" Command="{Binding SelectMediaFolderCommand}"
                                                      Classes="primary" ToolTip.Tip="Select media folder"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="200,*">
                                            <TextBlock Grid.Column="0" Text="Max Concurrent Uploads:" VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding MaxConcurrentUploads}" 
                                                         Minimum="1" Maximum="10" Width="150" HorizontalAlignment="Left"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="200,*">
                                            <TextBlock Grid.Column="0" Text="Media Quality (%):" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                <Slider Value="{Binding MediaQuality}" Minimum="50" Maximum="100" 
                                                      Width="200" TickFrequency="10"/>
                                                <TextBlock Text="{Binding MediaQuality, StringFormat='{}{0}%'}" 
                                                         VerticalAlignment="Center" MinWidth="40"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <CheckBox Content="Image Optimization" 
                                                IsChecked="{Binding EnableImageOptimization}"/>
                                        
                                        <CheckBox Content="Video Compression" 
                                                IsChecked="{Binding EnableVideoCompression}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                </StackPanel>
                    
                <!-- System Section -->
                <StackPanel Spacing="16" IsVisible="{Binding SelectedSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=System}">
                    <!-- System Information -->
                    <Border Background="{DynamicResource SMC-Card-Background}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="System Information" FontSize="16" FontWeight="SemiBold"/>
                                    
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="Version:" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ApplicationVersion}"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="Total Accounts:" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalAccounts}"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="Total Posts:" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalPosts}"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="Cache Size:" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="15.0 MB"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="150,*">
                                            <TextBlock Grid.Column="0" Text="Last Backup:" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LastBackupDate}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- System Actions -->
                            <Border Background="{DynamicResource SMC-Card-Background}" 
                                    BorderBrush="{DynamicResource SMC-Card-Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="16" BoxShadow="0 2 4 0 #10000000"
                                    Classes="SlideInBottom">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="System Actions" FontSize="16" FontWeight="SemiBold"/>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Create Backup" Command="{Binding CreateBackupCommand}"
                                              Classes="primary"
                                              IsEnabled="{Binding !IsLoading}"
                                              ToolTip.Tip="Create a backup of your data"/>
                                        
                                        <Button Content="Clear Cache" Command="{Binding ClearCacheCommand}"
                                              Classes="secondary"
                                              IsEnabled="{Binding !IsLoading}"
                                              ToolTip.Tip="Clear application cache"/>
                                        
                                        <Button Content="Export Settings" Command="{Binding ExportSettingsCommand}"
                                              Classes="primary"
                                              IsEnabled="{Binding !IsLoading}"
                                              ToolTip.Tip="Export settings to file"/>
                                        
                                        <Button Content="Import Settings" Command="{Binding ImportSettingsCommand}"
                                              Classes="secondary"
                                              IsEnabled="{Binding !IsLoading}"
                                              ToolTip.Tip="Import settings from file"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                    
                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Reset to Defaults" 
                                Command="{Binding ResetSettingsCommand}"
                                Classes="outline" 
                                Padding="16,10"
                                ToolTip.Tip="Reset all settings to default values"/>
                        <Button Content="Save Changes" 
                                Command="{Binding SaveSettingsCommand}"
                                Classes="primary" 
                                Padding="16,10"
                                ToolTip.Tip="Save all settings changes"/>
                    </StackPanel>
                    
                    <!-- Loading Indicator -->
                    <Border Background="{DynamicResource SMC-Card-Background}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="16"
                            IsVisible="{Binding IsLoading}">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Background="{DynamicResource SMC-Accent}" 
                                    CornerRadius="12" 
                                    Width="24" Height="24"
                                    Classes="Pulse">
                                <TextBlock Text="⏳" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Processing..." 
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource SMC-Foreground}" 
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl> 