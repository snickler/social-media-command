<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             xmlns:models="using:SocialMediaCommander.Core.Models"
             x:Class="SocialMediaCommander.Desktop.Views.AccountManagerView"
             x:DataType="vm:AccountManagerViewModel">

  <Grid RowDefinitions="Auto,*" Margin="20">
    
    <!-- Header Section -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Grid.Column="0" Orientation="Vertical">
        <TextBlock Text="Account Manager" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,4"/>
        <TextBlock Text="Manage your social media accounts across platforms" 
                   FontSize="14" 
                   Opacity="0.7"/>
      </StackPanel>
      
      <Button Grid.Column="1" 
              Content="Add Account" 
              Command="{Binding StartAddAccountCommand}"
              Padding="16,8"/>
    </Grid>
    
    <!-- Main Content -->
    <Grid Grid.Row="1" ColumnDefinitions="250,*">
      
      <!-- Platform Selector -->
      <Border Grid.Column="0" 
              Background="LightGray"
              Padding="16"
              Margin="0,0,12,0">
        
        <StackPanel>
          <TextBlock Text="Platforms" 
                     FontSize="16" 
                     FontWeight="SemiBold" 
                     Margin="0,0,0,12"/>
          
          <StackPanel>
            <Button Content="BlueSky" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="X (Twitter)" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="LinkedIn" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="Threads" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="Facebook" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </StackPanel>
      </Border>
      
      <!-- Account List and Forms -->
      <Grid Grid.Column="1">
        
        <!-- Account List (Default View) -->
        <ScrollViewer IsVisible="{Binding !IsAddingAccount}">
          <StackPanel>
            
            <!-- Platform Header -->
            <Grid ColumnDefinitions="*" Margin="0,0,0,16">
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedPlatformName}" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="Manage your accounts" 
                           FontSize="14" 
                           Opacity="0.7"/>
              </StackPanel>
            </Grid>
            
            <!-- No Accounts Message -->
            <Border IsVisible="{Binding !HasAccountsForPlatform}"
                    Background="LightBlue"
                    Padding="32"
                    HorizontalAlignment="Center">
              
              <StackPanel HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="No accounts yet" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Add your first account to get started" 
                           FontSize="14" 
                           Opacity="0.7" 
                           HorizontalAlignment="Center"/>
                <Button Content="Add Account" 
                        Command="{Binding StartAddAccountCommand}"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            
            <!-- Account Cards -->
            <ItemsControl ItemsSource="{Binding AccountsForSelectedPlatform}"
                          IsVisible="{Binding HasAccountsForPlatform}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:Account">
                  <Border Background="White"
                          BorderBrush="Gray"
                          BorderThickness="1"
                          Padding="16"
                          Margin="0,0,0,12">
                    
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      
                      <!-- Avatar Placeholder -->
                      <Border Grid.Column="0" 
                              Width="48" 
                              Height="48" 
                              Background="Gray"
                              Margin="0,0,16,0">
                        <TextBlock Text="👤" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="24"/>
                      </Border>
                      
                      <!-- Account Info -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Username}" 
                                   FontSize="14" 
                                   Opacity="0.7"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding IsDefault}" 
                                   FontSize="12" 
                                   Opacity="0.5"
                                   Margin="0,4,0,0"/>
                      </StackPanel>
                      
                      <!-- Actions -->
                      <StackPanel Grid.Column="2" 
                                  Orientation="Horizontal" 
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        
                        <Button Content="Edit" 
                                Command="{Binding $parent[UserControl].((vm:AccountManagerViewModel)DataContext).StartEditAccountCommand}"
                                CommandParameter="{Binding .}"
                                Padding="8,4"/>
                        
                        <Button Content="Delete" 
                                Command="{Binding $parent[UserControl].((vm:AccountManagerViewModel)DataContext).DeleteAccountCommand}"
                                CommandParameter="{Binding .}"
                                Padding="8,4"
                                IsVisible="{Binding !IsDefault}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        
        <!-- Add/Edit Account Form -->
        <ScrollViewer IsVisible="{Binding IsAddingAccount}">
          <Border Background="White"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Padding="24"
                  MaxWidth="500"
                  HorizontalAlignment="Center">
            
            <StackPanel Spacing="20">
              
              <!-- Form Header -->
              <StackPanel>
                <TextBlock Text="Add New Account" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedPlatformName}" 
                           FontSize="14" 
                           Opacity="0.7"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
              </StackPanel>
              
              <!-- Form Fields -->
              <StackPanel Spacing="16">
                
                <!-- Display Name -->
                <StackPanel>
                  <TextBlock Text="Display Name" 
                             FontSize="14" 
                             FontWeight="SemiBold" 
                             Margin="0,0,0,4"/>
                  <TextBox Text="{Binding NewAccountDisplayName}"
                           Watermark="Enter display name"
                           Padding="12"/>
                </StackPanel>
                
                <!-- Username -->
                <StackPanel>
                  <TextBlock Text="Username" 
                             FontSize="14" 
                             FontWeight="SemiBold" 
                             Margin="0,0,0,4"/>
                  <TextBox Text="{Binding NewAccountUsername}"
                           Watermark="Enter username"
                           Padding="12"/>
                </StackPanel>
                
                <!-- Avatar URL -->
                <StackPanel>
                  <TextBlock Text="Avatar URL (optional)" 
                             FontSize="14" 
                             FontWeight="SemiBold" 
                             Margin="0,0,0,4"/>
                  <TextBox Text="{Binding NewAccountAvatar}"
                           Watermark="Enter avatar URL"
                           Padding="12"/>
                </StackPanel>
              </StackPanel>
              
              <!-- Action Buttons -->
              <Grid ColumnDefinitions="*,12,*" Margin="0,8,0,0">
                <Button Grid.Column="0" 
                        Content="Cancel" 
                        Command="{Binding CancelAccountOperationCommand}"
                        Padding="0,12"/>
                
                <Button Grid.Column="2" 
                        Content="Add Account" 
                        Command="{Binding SaveAccountCommand}"
                        Padding="0,12"/>
              </Grid>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl> 