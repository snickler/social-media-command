<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             xmlns:models="using:SocialMediaCommander.Core.Models"
             x:Class="SocialMediaCommander.Desktop.Views.AccountManagerView"
             x:DataType="vm:AccountManagerViewModel">

    <UserControl.Styles>
        <!-- Account Card Styles -->
        <Style Selector="Border.AccountCard">
            <Setter Property="Background" Value="{DynamicResource SMC-Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <Style Selector="Border.AccountCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="Background" Value="{DynamicResource SMC-Muted}"/>
        </Style>
        
        <!-- Platform Header Styles -->
        <Style Selector="Border.PlatformHeader">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,16,0,12"/>
        </Style>
        
        <!-- Status Badge Styles -->
        <Style Selector="Border.StatusBadge">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        
        <!-- Action Button Styles -->
        <Style Selector="Button.AccountAction">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="card" Padding="24">
        <Grid RowDefinitions="Auto,*">
            
            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Account Manager" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource SMC-Foreground}"/>
                    <TextBlock Text="Manage your social media accounts and connections" 
                               FontSize="14" 
                               Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="Add Account" 
                        Command="{Binding AddAccountCommand}"
                        Classes="primary">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="+" FontWeight="Bold"/>
                            <TextBlock Text="Add Account"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
            
            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    
                    <!-- Loading State -->
                    <StackPanel IsVisible="{Binding IsLoading}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Spacing="16">
                        <Border Background="{DynamicResource SMC-Accent}" 
                                CornerRadius="50" 
                                Width="60" Height="60"
                                HorizontalAlignment="Center">
                            <TextBlock Text="⏳" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Loading accounts..." 
                                   FontSize="16" 
                                   Foreground="{DynamicResource SMC-Muted-Foreground}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Spacing="16"
                               IsVisible="{Binding !HasAccounts}">
                        <Border Background="{DynamicResource SMC-Muted}" 
                                CornerRadius="50" 
                                Width="80" Height="80"
                                HorizontalAlignment="Center">
                            <TextBlock Text="👤" 
                                       FontSize="32" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="No accounts connected" 
                                       FontSize="20" 
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SMC-Foreground}"/>
                            <TextBlock Text="Connect your social media accounts to start managing your content" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource SMC-Muted-Foreground}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="400"/>
                        </StackPanel>
                        
                        <!-- Platform Connection Buttons -->
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <!-- BlueSky -->
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.BlueSky}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="BS" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect BlueSky"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- X/Twitter -->
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.X}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="𝕏" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect X"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- LinkedIn -->
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.LinkedIn}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="in" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect LinkedIn"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Threads -->
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.Threads}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="@" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect Threads"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Facebook -->
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.Facebook}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="f" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect Facebook"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Authentication Status -->
                    <Border Background="{DynamicResource SMC-Card}"
                            BorderBrush="{DynamicResource SMC-Card-Border}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,16"
                            IsVisible="{Binding IsAuthenticating}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{DynamicResource SMC-Accent}" 
                                    CornerRadius="50" 
                                    Width="40" Height="40">
                                <TextBlock Text="🔐" 
                                           FontSize="16" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Authenticating..." 
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SMC-Foreground}"/>
                                <TextBlock Text="{Binding AuthenticationStatus}" 
                                           FontSize="14"
                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Account Groups -->
                    <ItemsControl ItemsSource="{Binding Accounts}"
                                 IsVisible="{Binding HasAccounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="AccountCard">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        
                                        <!-- Account Avatar -->
                                        <Border Grid.Column="0" 
                                                Width="48" Height="48" 
                                                CornerRadius="24"
                                                Background="#0085FF"
                                                Margin="0,0,16,0">
                                            <TextBlock Text="{Binding DisplayName[0]}" 
                                                       Foreground="White"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Account Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <TextBlock Text="{Binding Username, StringFormat='@{0}'}" 
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                            
                                            <!-- Status Badges -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{DynamicResource SMC-Success}"
                                                        CornerRadius="12"
                                                        Padding="8,4"
                                                        IsVisible="{Binding IsAuthenticated}">
                                                    <TextBlock Text="Connected" 
                                                               FontSize="10"
                                                               Foreground="White"
                                                               FontWeight="Medium"/>
                                                </Border>
                                                <Border Background="{DynamicResource SMC-Accent}"
                                                        CornerRadius="12"
                                                        Padding="8,4"
                                                        IsVisible="{Binding IsDefault}">
                                                    <TextBlock Text="Default" 
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SMC-Accent-Foreground}"
                                                               FontWeight="Medium"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" 
                                                   Orientation="Horizontal" 
                                                   Spacing="8"
                                                   VerticalAlignment="Center">
                                            
                                            <!-- Edit Button -->
                                            <Button Classes="AccountAction"
                                                   BorderBrush="{DynamicResource SMC-Card-Border}">
                                                <TextBlock Text="✏️" FontSize="14"/>
                                            </Button>
                                            
                                            <!-- Delete Button -->
                                            <Button Classes="AccountAction"
                                                   BorderBrush="{DynamicResource SMC-Warning-Border}">
                                                <TextBlock Text="🗑️" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl> 