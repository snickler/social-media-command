<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             xmlns:models="using:SocialMediaCommander.Core.Models"
             xmlns:converters="using:SocialMediaCommander.Desktop.Converters"
             x:Class="SocialMediaCommander.Desktop.Views.AccountManagerView"
             x:DataType="vm:AccountManagerViewModel">

    <!-- No custom UserControl.Styles needed - using global App.axaml styles -->

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel Spacing="24" MaxWidth="1000">
                <!-- Page Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseAccountManagerCommand}" 
                                    Classes="ghost"
                                    Width="36" Height="36"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    ToolTip.Tip="Back to Home">
                                <TextBlock Text="←" FontSize="16" FontWeight="Bold"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Account Manager" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SMC-Foreground}"/>
                                <TextBlock Text="Manage your social media accounts and connections" 
                                           FontSize="14" 
                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="TEST" 
                                Command="{Binding TestButtonCommand}"
                                Classes="outline"
                                Padding="12,8"
                                IsVisible="False"
                                ToolTip.Tip="Test account functionality">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🔧" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="TEST" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Command="{Binding AddAccountCommand}"
                                Classes="primary"
                                Padding="16,10"
                                ToolTip.Tip="Connect a new social media account">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Account" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                
                <StackPanel Spacing="16">
                    
                    <!-- Loading State -->
                    <StackPanel IsVisible="{Binding IsLoading}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Spacing="12"
                               Classes="FadeIn">
                        <Border Background="{DynamicResource SMC-Accent}" 
                                CornerRadius="40" 
                                Width="48" Height="48"
                                HorizontalAlignment="Center"
                                Classes="Pulse">
                            <TextBlock Text="⏳" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Loading accounts..." 
                                   FontSize="16" 
                                   Foreground="{DynamicResource SMC-Muted-Foreground}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Spacing="12"
                               IsVisible="{Binding !HasAccounts}">
                        <Border Background="{DynamicResource SMC-Muted}" 
                                CornerRadius="40" 
                                Width="64" Height="64"
                                HorizontalAlignment="Center">
                            <TextBlock Text="👤" 
                                       FontSize="32" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="No accounts connected" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SMC-Foreground}"/>
                            <TextBlock Text="Connect your social media accounts to start managing your content" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource SMC-Muted-Foreground}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="400"/>
                        </StackPanel>
                        
                        <!-- Platform Connection Buttons -->
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <!-- BlueSky -->
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.BlueSky}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="BS" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect BlueSky"/>
                                </StackPanel>
                            </Button>
                           
                            <!--X/Twitter 
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.X}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="𝕏" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect X"/>
                                </StackPanel>
                            </Button>
                             
                            
                            
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.LinkedIn}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="in" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect LinkedIn"/>
                                </StackPanel>
                            </Button>
                            
                            
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.Threads}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="@" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect Threads"/>
                                </StackPanel>
                            </Button>
                            
                            
                            <Button Command="{Binding ConnectAccountCommand}" 
                                   CommandParameter="{x:Static models:SocialPlatform.Facebook}"
                                   Classes="primary"
                                   Width="200">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="f" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Connect Facebook"/>
                                </StackPanel>
                            </Button> -->
                        </StackPanel> 
                    </StackPanel>
                    
                    <!-- Authentication Status -->
                    <Border Background="{DynamicResource SMC-Card-Background}"
                            BorderBrush="{DynamicResource SMC-Accent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Classes="Pulse"
                            IsVisible="{Binding IsAuthenticating}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{DynamicResource SMC-Accent}" 
                                    CornerRadius="40" 
                                    Width="36" Height="36">
                                <TextBlock Text="🔐" 
                                           FontSize="16" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Authenticating..." 
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SMC-Foreground}"/>
                                <TextBlock Text="{Binding AuthenticationStatus}" 
                                           FontSize="14"
                                           Foreground="{DynamicResource SMC-Muted-Foreground}"
                                           TextWrapping="Wrap"
                                           MaxWidth="600"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    

                    
                    <!-- Edit/Add Account Form -->
                    <Border Background="{DynamicResource SMC-Card-Background}"
                            BorderBrush="{DynamicResource SMC-Card-Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            IsVisible="{Binding IsEditingAccount}">
                        <StackPanel Spacing="16">
                            <!-- Form Header -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding IsAddingAccount, Converter={x:Static converters:BooleanToStringConverter.Instance}, ConverterParameter='Add New Account|Edit Account'}" 
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SMC-Foreground}"/>
                                <TextBlock Text="{Binding IsAddingAccount, Converter={x:Static converters:BooleanToStringConverter.Instance}, ConverterParameter='Configure your social media account and OAuth settings|Update your account information'}" 
                                           FontSize="14"
                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                            </StackPanel>
                            
                            <!-- Platform Selection (only for new accounts) -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsAddingAccount}">
                                <TextBlock Text="Platform" 
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource SMC-Foreground}"/>
                                <ComboBox ItemsSource="{Binding AvailablePlatforms}"
                                          SelectedItem="{Binding SelectedPlatformConfig}"
                                          Classes="modern"
                                          MinWidth="200">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{Binding Color}" 
                                                        Width="16" Height="16" 
                                                        CornerRadius="8"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Authentication Method Selection (only for BlueSky) -->
                            <StackPanel Spacing="8" IsVisible="{Binding ShowAuthMethodSelector}">
                                <TextBlock Text="Authentication Method" 
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource SMC-Foreground}"/>
                                <ComboBox ItemsSource="{Binding AvailableAuthMethods}"
                                          SelectedItem="{Binding SelectedAuthMethod}"
                                          Classes="modern"
                                          MinWidth="200">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource SMC-Muted-Foreground}"
                                           TextWrapping="Wrap">
                                    <Run Text="OAuth: More secure, requires developer account setup"/>
                                    <LineBreak/>
                                    <Run Text="App Password: Simpler, generate from BlueSky settings"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- OAuth Configuration Section (only for OAuth method) -->
                            <Border Background="{DynamicResource SMC-Muted}"
                                    BorderBrush="{DynamicResource SMC-Card-Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    IsVisible="{Binding IsOAuthAuthMethod}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="OAuth Configuration" 
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource SMC-Foreground}"/>
                                        <TextBlock Text="{Binding OAuthSetupGuidance}" 
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                    </StackPanel>
                                    
                                    <!-- OAuth Fields Grid -->
                                    <Grid ColumnDefinitions="1*,1*" RowDefinitions="Auto,Auto,Auto">
                                        <!-- Client ID -->
                                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,6,10">
                                            <TextBlock Text="Client ID" 
                                                       FontWeight="Medium"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <TextBox Text="{Binding OAuthClientId}"
                                                     Watermark="Your app's client ID"
                                                     Classes="modern"/>
                                        </StackPanel>
                                        
                                        <!-- Client Secret -->
                                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="6,0,0,10">
                                            <TextBlock Text="Client Secret" 
                                                       FontWeight="Medium"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <TextBox Text="{Binding OAuthClientSecret}"
                                                     Watermark="Your app's client secret"
                                                     PasswordChar="*"
                                                     Classes="modern"/>
                                        </StackPanel>
                                        
                                        <!-- Redirect URI -->
                                        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,10">
                                            <TextBlock Text="Redirect URI" 
                                                       FontWeight="Medium"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <TextBox Text="{Binding OAuthRedirectUri}"
                                                     Watermark="http://localhost:8080/callback"
                                                     Classes="modern"/>
                                        </StackPanel>
                                        
                                        <!-- Test OAuth Button -->
                                        <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" 
                                                   Orientation="Horizontal" 
                                                   Spacing="8"
                                                   HorizontalAlignment="Center">
                                            <Button Content="🔐 Test OAuth Configuration" 
                                                    Command="{Binding TestOAuthConfigCommand}"
                                                    Classes="secondary"
                                                    MinWidth="200"
                                                    ToolTip.Tip="Verify OAuth settings are valid"/>
                                            <Button Content="🚀 Start OAuth Flow" 
                                                    Command="{Binding StartOAuthFlowCommand}"
                                                    Classes="primary"
                                                    IsEnabled="{Binding CanTestOAuthConfig}"
                                                    MinWidth="200"
                                                    ToolTip.Tip="Begin OAuth authentication process"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- App Password Configuration Section (only for App Password method) -->
                            <Border Background="{DynamicResource SMC-Muted}"
                                    BorderBrush="{DynamicResource SMC-Card-Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    IsVisible="{Binding IsAppPasswordAuthMethod}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="BlueSky App Password" 
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource SMC-Foreground}"/>
                                        <TextBlock FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SMC-Muted-Foreground}">
                                            <Run Text="1. Go to BlueSky Settings → App Passwords"/>
                                            <LineBreak/>
                                            <Run Text="2. Click 'Add App Password'"/>
                                            <LineBreak/>
                                            <Run Text="3. Name it 'Social Media Commander'"/>
                                            <LineBreak/>
                                            <Run Text="4. Copy the generated password (format: xxxx-xxxx-xxxx-xxxx)"/>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <!-- App Password Field -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="App Password" 
                                                   FontWeight="Medium"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource SMC-Foreground}"/>
                                        <TextBox Text="{Binding AppPassword}"
                                                 Watermark="xxxx-xxxx-xxxx-xxxx"
                                                 PasswordChar="*"
                                                 Classes="modern"/>
                                        <TextBlock Text="⚠️ This password will be encrypted and stored securely" 
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                    </StackPanel>
                                    
                                    <!-- Test App Password Button -->
                                    <StackPanel Orientation="Horizontal" 
                                               Spacing="12"
                                               HorizontalAlignment="Center">
                                        <Button Content="🔐 Test App Password" 
                                                Command="{Binding TestAppPasswordCommand}"
                                                Classes="secondary"
                                                IsEnabled="{Binding CanSaveAppPasswordAccount}"
                                                MinWidth="200"
                                                ToolTip.Tip="Verify app password authentication"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Account Information Section -->
                            <Border Background="{DynamicResource SMC-Card}"
                                    BorderBrush="{DynamicResource SMC-Card-Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Account Information" 
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Foreground="{DynamicResource SMC-Foreground}"/>
                                    
                                    <!-- Account Fields Grid -->
                                    <Grid ColumnDefinitions="1*,1*" RowDefinitions="Auto,Auto,Auto">
                                        
                                        <!-- Username Field -->
                                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,6,10">
                                            <TextBlock Text="Username" 
                                                       FontWeight="Medium"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <TextBox Text="{Binding NewAccountUsername}"
                                                     Watermark="Enter username"
                                                     Classes="modern"/>
                                        </StackPanel>
                                        
                                        <!-- Display Name Field -->
                                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="6,0,0,10">
                                            <TextBlock Text="Display Name" 
                                                       FontWeight="Medium"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <TextBox Text="{Binding NewAccountDisplayName}"
                                                     Watermark="Enter display name"
                                                     Classes="modern"/>
                                        </StackPanel>
                                        
                                        <!-- Avatar URL Field -->
                                        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,10">
                                            <TextBlock Text="Avatar URL (Optional)" 
                                                       FontWeight="Medium"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <TextBox Text="{Binding NewAccountAvatar}"
                                                     Watermark="https://example.com/avatar.jpg"
                                                     Classes="modern"/>
                                        </StackPanel>
                                        
                                        <!-- Platform Display (edit mode only) -->
                                        <StackPanel Grid.Column="0" Grid.Row="2" Spacing="4" Margin="0,0,0,10"
                                                   IsVisible="{Binding !IsAddingAccount}">
                                            <TextBlock Text="Platform" 
                                                       FontWeight="Medium"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <Border Background="{DynamicResource SMC-Muted}"
                                                    BorderBrush="{DynamicResource SMC-Card-Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,8">
                                                <TextBlock Text="{Binding SelectedPlatformName}" 
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" 
                                       Spacing="8" 
                                       HorizontalAlignment="Right">
                                <Button Content="Cancel" 
                                        Command="{Binding CancelAccountOperationCommand}"
                                        Classes="secondary"
                                        MinWidth="100"
                                        ToolTip.Tip="Cancel and discard changes"/>
                                <Button Content="{Binding IsAddingAccount, Converter={x:Static converters:BooleanToStringConverter.Instance}, ConverterParameter='Create Account|Save Changes'}" 
                                        Command="{Binding SaveAccountCommand}"
                                        Classes="primary"
                                        MinWidth="120"
                                        ToolTip.Tip="Save account configuration"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Account Groups -->
                    <ItemsControl ItemsSource="{Binding AccountViewModels}"
                                 IsVisible="{Binding HasAccounts}"
                                 x:Name="AccountsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SMC-Card-Background}"
                                        BorderBrush="{DynamicResource SMC-Card-Border}" 
                                        BorderThickness="1"
                                        CornerRadius="8" 
                                        Padding="16" 
                                        Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        
                                        <!-- Account Avatar -->
                                        <Border Grid.Column="0" 
                                                Width="40" Height="40" 
                                                CornerRadius="20"
                                                Background="#0085FF"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       Foreground="White"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Account Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SMC-Foreground}"/>
                                            <TextBlock Text="{Binding Username, StringFormat='@{0}'}" 
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                            
                                            <!-- Status Badges -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{DynamicResource SMC-Success}"
                                                        CornerRadius="12"
                                                        Padding="8,4"
                                                        IsVisible="{Binding IsConnected}">
                                                    <TextBlock Text="Connected" 
                                                               FontSize="10"
                                                               Foreground="White"
                                                               FontWeight="Medium"/>
                                                </Border>
                                                <Border Background="{DynamicResource SMC-Accent}"
                                                        CornerRadius="12"
                                                        Padding="8,4"
                                                        IsVisible="{Binding IsDefault}">
                                                    <TextBlock Text="Default" 
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SMC-Accent-Foreground}"
                                                               FontWeight="Medium"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" 
                                                   Orientation="Horizontal" 
                                                   Spacing="8"
                                                   VerticalAlignment="Center">
                                            
                                            <!-- Edit Button -->
                                            <Button Classes="ghost"
                                                   Width="32" Height="32"
                                                   Command="{Binding $parent[UserControl].((vm:AccountManagerViewModel)DataContext).EditAccountCommand}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip.Tip="Edit Account">
                                                <TextBlock Text="✏️" FontSize="14"/>
                                            </Button>
                                            
                                            <!-- Delete Button -->
                                            <Button Classes="ghost"
                                                   Width="32" Height="32"
                                                   Command="{Binding $parent[UserControl].((vm:AccountManagerViewModel)DataContext).RemoveAccountCommand}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip.Tip="Delete Account">
                                                <TextBlock Text="🗑️" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>