<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             x:Class="SocialMediaCommander.Desktop.Views.SchedulerView"
             x:DataType="vm:SchedulerViewModel">

  <Border Classes="card"
          Padding="0">
    
    <Grid RowDefinitions="Auto,*,Auto">
      
      <!-- Header -->
      <Grid Grid.Row="0" Margin="20,20,20,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0" 
                   Text="Post Scheduler" 
                   Classes="h2"
                   Foreground="{StaticResource PrimaryBrush}"
                   VerticalAlignment="Center"/>
        
        <StackPanel Grid.Column="1" 
                   Orientation="Horizontal" 
                   Spacing="8">
          <Button Content="📅 Calendar View" 
                 Command="{Binding SwitchToCalendarViewCommand}"
                 Classes="outline"/>
          <Button Content="➕ Schedule Post" 
                 Command="{Binding ScheduleNewPostCommand}"
                 Classes="primary"/>
        </StackPanel>
      </Grid>
      
      <!-- Main Content -->
      <ScrollViewer Grid.Row="1" 
                   Padding="20,0,20,0"
                   VerticalScrollBarVisibility="Auto">
        
        <StackPanel Spacing="24">
          
          <!-- Quick Actions -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Today's Posts -->
            <Border Grid.Column="0" 
                   Classes="status-info interactive"
                   Padding="20"
                   Margin="0,0,8,0">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="📅" FontSize="24"/>
                  <StackPanel>
                    <TextBlock Text="Today's Posts" 
                              Classes="h3"
                              Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="3 scheduled" 
                              Classes="p"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                  </StackPanel>
                </StackPanel>
                <Button Content="View Schedule" 
                       Classes="outline"
                       FontSize="12"/>
              </StackPanel>
            </Border>
            
            <!-- This Week -->
            <Border Grid.Column="1" 
                   Classes="status-warning interactive"
                   Padding="20"
                   Margin="4,0,4,0">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="📊" FontSize="24"/>
                  <StackPanel>
                    <TextBlock Text="This Week" 
                              Classes="h3"
                              Foreground="{StaticResource WarningDarkBrush}"/>
                    <TextBlock Text="12 scheduled" 
                              Classes="p"
                              Foreground="{StaticResource TextMutedBrush}"/>
                  </StackPanel>
                </StackPanel>
                <Button Content="Weekly View" 
                       Classes="outline"
                       FontSize="12"/>
              </StackPanel>
            </Border>
            
            <!-- Templates -->
            <Border Grid.Column="2" 
                   Classes="status-success interactive"
                   Padding="20"
                   Margin="8,0,0,0">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="📝" FontSize="24"/>
                  <StackPanel>
                    <TextBlock Text="Templates" 
                              Classes="h3"
                              Foreground="{StaticResource SuccessDarkBrush}"/>
                    <TextBlock Text="8 available" 
                              Classes="p"
                              Foreground="{StaticResource TextMutedBrush}"/>
                  </StackPanel>
                </StackPanel>
                <Button Content="Browse Templates" 
                       Classes="outline"
                       FontSize="12"/>
              </StackPanel>
            </Border>
          </Grid>
          
          <!-- Upcoming Posts -->
          <Border Classes="card"
                 Padding="20">
            <StackPanel Spacing="16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="Upcoming Posts" 
                          Classes="h2"/>
                <ComboBox Grid.Column="1" 
                         MinWidth="120"
                         Padding="8"
                         CornerRadius="6">
                  <ComboBoxItem Content="Next 7 days" IsSelected="True"/>
                  <ComboBoxItem Content="Next 30 days"/>
                  <ComboBoxItem Content="All scheduled"/>
                </ComboBox>
              </Grid>
              
              <!-- Mock Scheduled Posts -->
              <StackPanel Spacing="12">
                
                <!-- Post 1 -->
                <Border Classes="card-secondary"
                       Padding="16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Time Info -->
                    <Border Grid.Column="0" 
                           Background="{StaticResource PrimaryLightBrush}"
                           CornerRadius="6"
                           Padding="12"
                           Margin="0,0,16,0">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Dec" 
                                  Classes="p-small"
                                  FontWeight="Medium"
                                  Foreground="{StaticResource PrimaryDarkBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="15" 
                                  Classes="h3"
                                  Foreground="{StaticResource PrimaryDarkBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="09:00" 
                                  Classes="p-small" 
                                  Foreground="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    
                    <!-- Post Content -->
                    <StackPanel Grid.Column="1" Spacing="8">
                      <TextBlock Text="Product Launch Announcement" 
                                Classes="h3"/>
                      <TextBlock Text="Excited to announce our new product launch! Check out the amazing features..." 
                                Classes="p"
                                Foreground="{StaticResource TextMutedBrush}"
                                TextTrimming="CharacterEllipsis"/>
                      
                      <!-- Platform Badges -->
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Classes="badge-bluesky">
                          <TextBlock Text="BlueSky" Classes="badge-text"/>
                        </Border>
                        <Border Classes="badge-linkedin">
                          <TextBlock Text="LinkedIn" Classes="badge-text"/>
                        </Border>
                        <Border Classes="badge-facebook">
                          <TextBlock Text="Facebook" Classes="badge-text"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    
                    <!-- Status -->
                    <Border Grid.Column="2" 
                           Classes="badge-success"
                           Padding="8,4"
                           Margin="16,0,0,0"
                           VerticalAlignment="Top">
                      <TextBlock Text="✅ Scheduled" 
                                Classes="badge-text"/>
                    </Border>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3" 
                               Orientation="Horizontal" 
                               Spacing="8" 
                               VerticalAlignment="Center">
                        <Button Content="✏️" Classes="ghost"/>
                        <Button Content="🗑️" Classes="destructive"/>
                    </StackPanel>
                  </Grid>
                </Border>
                
                <!-- Post 2 -->
                <Border Classes="card-secondary"
                       Padding="16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Time Info -->
                    <Border Grid.Column="0" 
                           Background="{StaticResource PrimaryLightBrush}"
                           CornerRadius="6"
                           Padding="12"
                           Margin="0,0,16,0">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Dec" 
                                  Classes="p-small"
                                  FontWeight="Medium"
                                  Foreground="{StaticResource PrimaryDarkBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="18" 
                                  Classes="h3"
                                  Foreground="{StaticResource PrimaryDarkBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="14:30" 
                                  Classes="p-small" 
                                  Foreground="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    
                    <!-- Post Content -->
                    <StackPanel Grid.Column="1" Spacing="8">
                      <TextBlock Text="Weekly Tech Roundup" 
                                Classes="h3"/>
                      <TextBlock Text="This week's top tech news and updates. Don't miss out on the latest trends..." 
                                Classes="p" 
                                Foreground="{StaticResource TextMutedBrush}"
                                TextTrimming="CharacterEllipsis"/>
                      
                      <!-- Platform Badges -->
                      <StackPanel Orientation="Horizontal" Spacing="4">
                         <Border Classes="badge-x">
                          <TextBlock Text="X (Twitter)" Classes="badge-text"/>
                        </Border>
                        <Border Classes="badge-threads">
                          <TextBlock Text="Threads" Classes="badge-text"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    
                    <!-- Status -->
                    <Border Grid.Column="2" 
                           Classes="badge-success"
                           Padding="8,4"
                           Margin="16,0,0,0"
                           VerticalAlignment="Top">
                      <TextBlock Text="✅ Scheduled" 
                                Classes="badge-text"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3" 
                               Orientation="Horizontal" 
                               Spacing="8" 
                               VerticalAlignment="Center">
                        <Button Content="✏️" Classes="ghost"/>
                        <Button Content="🗑️" Classes="destructive"/>
                    </StackPanel>
                  </Grid>
                </Border>

              </StackPanel>
            </StackPanel>
          </Border>
          
        </StackPanel>
        
      </ScrollViewer>
      
      <!-- Footer -->
      <Border Grid.Row="2" 
              Classes="card-footer"
              Padding="20,12">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="✅ All systems operational" 
                    Classes="p-small" 
                    Foreground="{StaticResource SuccessDarkBrush}"/>
          <TextBlock Text="Server time: 14:52:10 UTC" 
                    Classes="p-small" 
                    Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
      </Border>
      
    </Grid>
    
  </Border>
  
</UserControl> 