<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SocialMediaCommander.Desktop.Views.PostEditorView"
             x:DataType="vm:PostEditorViewModel">

  <Design.DataContext>
    <vm:PostEditorViewModel />
  </Design.DataContext>

  <Grid Background="{DynamicResource SystemRegionBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20" Spacing="16">
        
        <!-- Header Section -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title and Controls -->
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              
              <TextBlock Grid.Column="0" 
                        Text="Compose Post" 
                        FontSize="20" 
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
              
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <!-- Thread Mode Toggle -->
                <StackPanel Orientation="Horizontal" 
                           Spacing="8" 
                           IsVisible="{Binding ThreadSupported}">
                  <ToggleButton IsChecked="{Binding IsThread}"
                               IsEnabled="{Binding !ThreadsOnlyMode}"
                               Content="Thread"/>
                </StackPanel>
                
                <!-- Threads Only Mode Indicator -->
                <Border IsVisible="{Binding ThreadsOnlyMode}"
                       Background="{DynamicResource SystemFillColorAttentionBrush}"
                       CornerRadius="4"
                       Padding="8,4">
                  <TextBlock Text="Threads Only Mode" 
                            FontSize="12" 
                            FontWeight="Medium"/>
                </Border>
                
                <!-- Promo Mode Toggle -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleButton IsChecked="{Binding PromoMode}"
                               Content="Promo Mode"/>
                </StackPanel>
              </StackPanel>
            </Grid>
            
            <!-- Mode Indicators -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
              <TextBlock Text="Composer Mode" FontWeight="Medium"/>
              <TextBlock Text="Thread Mode" FontWeight="Medium" IsVisible="{Binding IsThread}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main Content Editor -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
          
          <!-- Simplified Content for Build -->
          <StackPanel Spacing="16">
            
            <!-- Main Text Editor -->
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              
              <TextBox Grid.Row="0"
                      Text="{Binding Content}"
                      MinHeight="120"
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      Watermark="What's happening?"
                      BorderThickness="1"
                      CornerRadius="6"/>
              
              <!-- Character Count -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock Text="{Binding Content.Length}" 
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="/" 
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding MaxCharacterCount}" 
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Grid>
            
            <!-- Hashtags Section -->
            <StackPanel Spacing="8">
              <TextBlock Text="Hashtags" FontWeight="Medium"/>
              <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                     BorderThickness="1"
                     CornerRadius="6"
                     Padding="8">
                <ItemsControl ItemsSource="{Binding Hashtags}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                             CornerRadius="4"
                             Margin="2"
                             Padding="8,4">
                        <TextBlock Text="{Binding StringFormat=#{0}}"
                                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
            
            <!-- Thread Posts Section -->
            <StackPanel Spacing="8" IsVisible="{Binding IsThread}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="Thread Posts" 
                          FontWeight="Medium" 
                          FontSize="16"/>
                
                <Button Grid.Column="1" 
                       Content="Add Post"
                       Command="{Binding AddNewThreadPostCommand}"/>
              </Grid>
              
              <ItemsControl ItemsSource="{Binding ThreadPosts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                           BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                           BorderThickness="1"
                           CornerRadius="6"
                           Margin="0,0,0,8"
                           Padding="12">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Thread Post"
                                  FontWeight="Medium"
                                  FontSize="14"/>
                        
                        <TextBox Text="{Binding Content}"
                                MinHeight="80"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"/>
                        
                        <TextBlock Text="{Binding Content.Length, StringFormat={}{0} characters}"
                                  HorizontalAlignment="Right"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            
          </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Content="Save Draft"
                   Command="{Binding SaveDraftCommand}"/>
            <Button Content="Publish Post"
                   Command="{Binding PublishPostCommand}"
                   IsEnabled="{Binding CanPost}"
                   Background="{DynamicResource AccentFillColorDefaultBrush}"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
          </StackPanel>
        </Border>

        <!-- Character Count Summary -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                IsVisible="{Binding CharacterCounts.Count}">
          <StackPanel>
            <TextBlock Text="Character Counts by Platform" 
                      FontWeight="Medium" 
                      Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding CharacterCounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="100"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="{Binding Platform}"
                              VerticalAlignment="Center"/>
                    
                    <ProgressBar Grid.Column="1"
                                Value="{Binding Count}"
                                Maximum="{Binding MaxCount}"
                                Margin="8,0"
                                VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="2"
                              Text="{Binding Count, StringFormat={}{0}}"
                              VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        
      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl> 