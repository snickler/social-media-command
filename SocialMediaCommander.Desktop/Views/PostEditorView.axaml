<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="SocialMediaCommander.Desktop.Views.PostEditorView"
             x:DataType="vm:PostEditorViewModel">

    <UserControl.Styles>
        <!-- Platform Toggle Styles -->
        <Style Selector="ToggleButton.PlatformToggle">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Foreground}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.PlatformToggle:checked">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ToggleButton.PlatformToggle:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="ToggleButton.PlatformToggle:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        
        <!-- Tab Button Styles -->
        <Style Selector="RadioButton.TabButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Foreground}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="8,8,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.TabButton:checked">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
        </Style>
        <Style Selector="RadioButton.TabButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SMC-Muted}"/>
        </Style>
        
        <!-- Thread Post Card Styles -->
        <Style Selector="Border.ThreadPostCard">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #10000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ThreadPostCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #20000000"/>
        </Style>
        
        <!-- Preview Card Styles -->
        <Style Selector="Border.PreviewCard">
            <Setter Property="Background" Value="{DynamicResource SMC-Muted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BoxShadow" Value="0 2 6 0 #10000000"/>
        </Style>
        
        <!-- Loading Animation Style -->
        <Style Selector="Border.LoadingCard">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="0">
        <!-- Header -->
        <Border Background="{DynamicResource SMC-Card-Background}" 
                BorderBrush="{DynamicResource SMC-Card-Border}" 
                BorderThickness="1,1,1,0" 
                CornerRadius="12,12,0,0" 
                Padding="24,20,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Compose Post" 
                           FontSize="20" FontWeight="SemiBold" 
                           Foreground="{DynamicResource SMC-Accent}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                    <!-- Thread Toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                IsVisible="{Binding ThreadSupported}">
                        <TextBlock Text="Thread" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                        <ToggleSwitch IsChecked="{Binding IsThread}" 
                                      OnContent="" OffContent=""/>
                    </StackPanel>

                    <!-- Promo Mode Toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Promo Mode" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                        <ToggleSwitch IsChecked="{Binding PromoMode}" 
                                      OnContent="" OffContent=""/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Headers -->
        <Border Background="{DynamicResource SMC-Card-Background}" 
                BorderBrush="{DynamicResource SMC-Card-Border}" 
                BorderThickness="1,0,1,1" 
                Padding="24,0,24,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Composer" Classes="TabButton" GroupName="EditorTabs" 
                             IsChecked="True"
                             Command="{Binding SwitchToComposerCommand}"/>
                <RadioButton Content="Preview" Classes="TabButton" GroupName="EditorTabs" 
                             IsChecked="{Binding IsPreviewTabActive, Mode=TwoWay}"
                             IsEnabled="{Binding HasSelectedPlatforms}"
                             Command="{Binding SwitchToPreviewCommand}"/>
            </StackPanel>
        </Border>

        <!-- Tab Content -->
        <Border Background="{DynamicResource SMC-Card-Background}" 
                BorderBrush="{DynamicResource SMC-Card-Border}" 
                BorderThickness="1,0,1,0" 
                Padding="24">
            <StackPanel>
                <!-- Composer Tab Content -->
                <StackPanel IsVisible="{Binding IsComposerTabActive}"
                            Spacing="24">
                    
                    <!-- Target Platforms Section -->
                    <StackPanel Spacing="16">
                        <TextBlock Text="Target Platforms" FontSize="16" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding AvailablePlatforms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Margin="0,0,12,12">
                                        <!-- Platform Toggle -->
                                        <ToggleButton Classes="PlatformToggle" 
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="✓" IsVisible="{Binding IsSelected}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding CharacterLimit, StringFormat='({0} chars)'}" 
                                                           Opacity="0.6" FontSize="12"
                                                           IsVisible="{Binding HasCharacterLimit}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        
                                        <!-- Account Selector (shown when platform is selected) -->
                                        <ComboBox IsVisible="{Binding IsSelected}"
                                                  ItemsSource="{Binding AvailableAccounts}"
                                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                                  Width="200"
                                                  FontSize="12"
                                                  Padding="8,4">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="👤" FontSize="12"/>
                                                        <TextBlock Text="{Binding DisplayText}" 
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="✓" 
                                                                   FontSize="10" 
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SMC-Success}"
                                                                   IsVisible="{Binding IsAuthenticated}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        
                                        <!-- Account display text (read-only indicator) -->
                                        <TextBlock Text="{Binding AccountDisplayText}"
                                                   IsVisible="{Binding IsSelected}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SMC-Muted-Foreground}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Main Post Section -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Main Post" FontSize="16" FontWeight="Medium"/>
                            <Border Grid.Column="1" 
                                    Background="{DynamicResource SMC-Muted}" 
                                    CornerRadius="4" Padding="8,4"
                                    IsVisible="{Binding IsThread}">
                                <TextBlock Text="First post in thread" FontSize="12" 
                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                            </Border>
                        </Grid>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource SMC-Card-Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    DragDrop.AllowDrop="True">
                                <Grid>
                                    <TextBox Text="{Binding Content}" 
                                             Watermark="What would you like to share today?"
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             MinHeight="120"
                                             MaxHeight="300"
                                             BorderThickness="0"
                                             Background="Transparent"/>
                                    
                                    <!-- Drag-and-drop overlay -->
                                    <Border Background="{DynamicResource SMC-Accent}"
                                            Opacity="0.9"
                                            CornerRadius="8"
                                            IsVisible="False"
                                            Name="DragOverlay">
                                        <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Drop media files here" 
                                                       FontSize="16" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SMC-Accent-Foreground}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Images, videos, or GIFs" 
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SMC-Accent-Foreground}"
                                                       Opacity="0.8"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Upload Media Button -->
                            <Button Grid.Row="1"
                                    Content="📷 Upload Media"
                                    Classes="outline"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    Command="{Binding UploadMediaCommand}"
                                    IsVisible="{Binding MediaSupported}"/>
                        </Grid>
                        
                        <!-- Media Section -->
                        <StackPanel Spacing="8" IsVisible="{Binding MediaSupported}">
                            <TextBlock Text="Media" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Text="Add up to 4 images or videos (click Upload Media or drag &amp; drop onto text box)" 
                                       FontSize="12" Opacity="0.7"/>
                            
                            <!-- Media Preview Grid -->
                            <Grid Name="MediaGrid" 
                                  IsVisible="{Binding Media.Count}"
                                  ColumnDefinitions="*,*,*,*" 
                                  RowDefinitions="Auto" 
                                  ColumnSpacing="8">
                                
                                <ItemsControl ItemsSource="{Binding Media}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" ItemWidth="150" ItemHeight="150"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="150" Height="150" 
                                                    CornerRadius="8" 
                                                    Margin="0,0,8,8"
                                                    BorderBrush="{DynamicResource SMC-Card-Border}" 
                                                    BorderThickness="1"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <!-- Image Preview -->
                                                    <Border Background="{DynamicResource SMC-Muted}">
                                                        <Image Source="{Binding FilePath}" 
                                                               Stretch="UniformToFill"
                                                               Width="150" 
                                                               Height="150"/>
                                                    </Border>
                                                    
                                                    <!-- File Info Overlay (Bottom) -->
                                                    <Border Background="#AA000000" 
                                                            VerticalAlignment="Bottom"
                                                            Padding="8,4">
                                                        <TextBlock Text="{Binding FileName}" 
                                                                   Foreground="White"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    
                                                    <!-- Delete Button Overlay (Top Right) -->
                                                    <Button Background="#AAFF0000" 
                                                            Foreground="White"
                                                            Width="24" 
                                                            Height="24" 
                                                            Padding="0"
                                                            VerticalAlignment="Top" 
                                                            HorizontalAlignment="Right"
                                                            Margin="4"
                                                            CornerRadius="12"
                                                            Command="{Binding $parent[UserControl].DataContext.RemoveMediaCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="✕" 
                                                                   FontSize="14" 
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            
                            <!-- Media Count Info -->
                            <TextBlock Text="{Binding Media.Count, StringFormat='{}{0} of 4 media files'}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource SMC-Muted-Foreground}"
                                       IsVisible="{Binding Media.Count}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Thread Posts Section -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsThread}">
                        <Separator Height="1" Background="{DynamicResource SMC-Card-Border}"/>
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Thread Posts" FontSize="16" FontWeight="Medium"/>
                            <Button Grid.Column="1" Content="➕ Add Post" 
                                    Classes="outline" 
                                    Command="{Binding AddThreadPostCommand}"/>
                        </Grid>

                        <!-- Thread Posts List -->
                        <ItemsControl ItemsSource="{Binding ThreadPosts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="ThreadPostCard">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" 
                                                        Background="{DynamicResource SMC-Accent}" 
                                                        CornerRadius="12" 
                                                        Width="24" Height="24">
                                                    <TextBlock Text="{Binding OrderIndex}" 
                                                               Foreground="{DynamicResource SMC-Accent-Foreground}"
                                                               FontSize="12" FontWeight="Bold"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding DisplayIndex}" 
                                                           FontWeight="Medium" VerticalAlignment="Center" 
                                                           Margin="12,0,0,0"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                    <Button Content="⬆️" Width="32" Height="32" Classes="ghost" 
                                                            ToolTip.Tip="Move up" FontSize="16"/>
                                                    <Button Content="⬇️" Width="32" Height="32" Classes="ghost" 
                                                            ToolTip.Tip="Move down" FontSize="16"/>
                                                    <Button Content="🗑️" Width="32" Height="32" Classes="ghost" 
                                                            ToolTip.Tip="Delete post" FontSize="16"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <Border Grid.Row="0"
                                                        BorderBrush="{DynamicResource SMC-Card-Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        DragDrop.AllowDrop="True">
                                                    <Grid>
                                                        <TextBox Text="{Binding Content}" 
                                                                 Watermark="Thread post content..."
                                                                 AcceptsReturn="True" 
                                                                 TextWrapping="Wrap" 
                                                                 MinHeight="80"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"/>
                                                        
                                                        <!-- Drag-and-drop overlay -->
                                                        <Border Background="{DynamicResource SMC-Accent}"
                                                                Opacity="0.9"
                                                                CornerRadius="8"
                                                                IsVisible="False"
                                                                Name="ThreadDragOverlay">
                                                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Drop media here" 
                                                                           FontSize="14" 
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource SMC-Accent-Foreground}"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                
                                                <!-- Upload Media Button for thread post -->
                                                <Button Grid.Row="1"
                                                        Content="📷 Upload Media"
                                                        Classes="outline"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,8,0,0"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Command="{Binding UploadMediaCommand}"/>
                                            </Grid>

                                            <!-- Thread Post Media Section -->
                                            <StackPanel Spacing="8" IsVisible="{Binding Media.Count}">
                                                <TextBlock Text="{Binding Media.Count, StringFormat='Media ({0})'}" 
                                                           FontSize="12" 
                                                           FontWeight="Medium"/>
                                                
                                                <!-- Media Preview Grid -->
                                                <ItemsControl ItemsSource="{Binding Media}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" ItemWidth="120" ItemHeight="120"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="120" Height="120" 
                                                                    CornerRadius="6" 
                                                                    Margin="0,0,8,8"
                                                                    BorderBrush="{DynamicResource SMC-Card-Border}" 
                                                                    BorderThickness="1"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <!-- Image Preview -->
                                                                    <Border Background="{DynamicResource SMC-Muted}">
                                                                        <Image Source="{Binding FilePath}" 
                                                                               Stretch="UniformToFill"
                                                                               Width="120" 
                                                                               Height="120"/>
                                                                    </Border>
                                                                    
                                                                    <!-- File Info Overlay (Bottom) -->
                                                                    <Border Background="#AA000000" 
                                                                            VerticalAlignment="Bottom"
                                                                            Padding="6,3">
                                                                        <TextBlock Text="{Binding FileName}" 
                                                                                   Foreground="White"
                                                                                   FontSize="9"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </Border>
                                                                    
                                                                    <!-- Delete Button Overlay (Top Right) -->
                                                                    <Button Background="#AAFF0000" 
                                                                            Foreground="White"
                                                                            Width="20" 
                                                                            Height="20" 
                                                                            Padding="0"
                                                                            VerticalAlignment="Top" 
                                                                            HorizontalAlignment="Right"
                                                                            Margin="3"
                                                                            CornerRadius="10"
                                                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveMediaCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Text="✕" 
                                                                                   FontSize="11" 
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center" 
                                                                                   VerticalAlignment="Center"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- Media Count Info -->
                                                <TextBlock Text="{Binding Media.Count, StringFormat='{}{0} of 4 media files'}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <Border IsVisible="{Binding HasNoThreadPosts}" 
                                BorderBrush="{DynamicResource SMC-Card-Border}" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Padding="24"
                                Opacity="0.6">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="No thread posts added yet" 
                                           HorizontalAlignment="Center" 
                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                <TextBlock Text="Add posts to create a thread" 
                                           FontSize="12" 
                                           HorizontalAlignment="Center" 
                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Hashtags Section (Promo Mode) -->
                    <Border IsVisible="{Binding PromoMode}" 
                            Background="{DynamicResource SMC-Muted}" 
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Hashtags" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="Add hashtags to increase discoverability (shown in promo mode only)" 
                                           FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                            
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding NewHashtag}" 
                                             Watermark="Enter hashtag..."/>
                                    <Button Grid.Column="1" Content="Add" 
                                            Command="{Binding AddHashtagCommand}"
                                            Margin="8,0,0,0"/>
                                </Grid>
                                
                                                                                <ItemsControl ItemsSource="{Binding Hashtags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SMC-Accent}" 
                                                    CornerRadius="16" 
                                                    Padding="8,4" 
                                                    Margin="0,0,8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding, StringFormat='#{0}'}" 
                                                               Foreground="{DynamicResource SMC-Accent-Foreground}"
                                                               FontSize="12"/>
                                                    <Button Content="✕" 
                                                            Background="Transparent" 
                                                            Foreground="{DynamicResource SMC-Accent-Foreground}"
                                                            BorderThickness="0" 
                                                            Padding="2" 
                                                            FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Preview Tab Content -->
                <StackPanel IsVisible="{Binding IsPreviewTabActive}"
                            Spacing="16">
                    <ItemsControl ItemsSource="{Binding PlatformPreviews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="PreviewCard">
                                    <StackPanel Spacing="12">
                                        <!-- Header with Platform Name and Copy Button -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding PlatformName}" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource SMC-Accent}"/>
                                                <TextBlock Text="Preview" FontSize="14" 
                                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                                <Border Background="{DynamicResource SMC-Accent}" 
                                                        CornerRadius="12" Padding="6,2"
                                                        IsVisible="{Binding IsOverLimit}">
                                                    <TextBlock Text="Over Limit" 
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SMC-Accent-Foreground}"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="📋 Copy" 
                                                    Classes="outline" 
                                                    FontSize="12" 
                                                    Padding="8,4"
                                                    Command="{Binding CopyToClipboardCommand}"/>
                                        </Grid>
                                        
                                        <!-- Content Preview -->
                                        <Border Background="{DynamicResource SMC-Card-Background}" 
                                                CornerRadius="6" Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding FormattedContent}" 
                                                           TextWrapping="Wrap" 
                                                           FontSize="14"/>
                                                
                                                <!-- Thread Indicator -->
                                                <Border IsVisible="{Binding IsThread}"
                                                        Background="{DynamicResource SMC-Muted}"
                                                        CornerRadius="4" Padding="8,4">
                                                    <TextBlock Text="{Binding ThreadIndicatorText}" 
                                                               FontSize="12" FontWeight="Medium"
                                                               Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                                </Border>
                                                
                                                <!-- Media Indicator -->
                                                <Border IsVisible="{Binding HasMedia}"
                                                        Background="{DynamicResource SMC-Muted}"
                                                        CornerRadius="4" Padding="8,4">
                                                    <TextBlock Text="{Binding MediaIndicatorText}" 
                                                               FontSize="12" FontWeight="Medium"
                                                               Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Footer with Character Count -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Character count:" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                                                <TextBlock Text="{Binding CharacterCountText}" 
                                                           FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource SMC-Foreground}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Empty State for Preview -->
                    <Border IsVisible="{Binding !HasSelectedPlatforms}" 
                            BorderBrush="{DynamicResource SMC-Card-Border}" 
                            BorderThickness="2" 
                            CornerRadius="8" 
                            Padding="24"
                            Opacity="0.6">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="No platforms selected" 
                                       HorizontalAlignment="Center" 
                                       Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                            <TextBlock Text="Select platforms to see preview" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Background="{DynamicResource SMC-Muted}" 
                BorderBrush="{DynamicResource SMC-Card-Border}" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,12,12" 
                Padding="24,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="14" 
                               Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                    <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasSelectedPlatforms}">
                        <TextBlock Text="{Binding CharacterCounts.Count, StringFormat='Character counts for {0} platforms'}" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource SMC-Muted-Foreground}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="{Binding PostButtonText}" 
                        Classes="secondary" 
                        Command="{Binding PostCommand}"
                        IsEnabled="{Binding CanPost}"
                        FontWeight="SemiBold"
                        Padding="24,12"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>