<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SocialMediaCommander.Desktop.Views.PostEditorView"
             x:DataType="vm:PostEditorViewModel">

  <Design.DataContext>
    <vm:PostEditorViewModel />
  </Design.DataContext>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Margin="0,0,0,20">
      
      <!-- Platform Selection -->
      <Border Background="White" 
              CornerRadius="8" 
              Padding="20"
              BoxShadow="0 1 3 0 #19000000">
        
        <StackPanel Spacing="16">
          <TextBlock Text="Target Platforms" 
                     FontSize="16" 
                     FontWeight="SemiBold"
                     Foreground="#374151"/>
          
          <!-- Platform Grid -->
          <ItemsControl ItemsSource="{Binding AvailablePlatforms}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding $parent[UserControl].((vm:PostEditorViewModel)DataContext).TogglePlatformCommand}"
                        CommandParameter="{Binding}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        CornerRadius="6"
                        BorderThickness="2"
                        Background="Transparent"
                        BorderBrush="#E5E7EB"
                        Foreground="#374151">
                  
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="16" Height="16" 
                            CornerRadius="8"
                            Background="{Binding Color}">
                      <TextBlock Text="✓" 
                                FontSize="10" 
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="{Binding Name}" 
                              FontWeight="Medium"/>
                    
                    <TextBlock Text="{Binding CharacterLimit, StringFormat='{}{0} chars'}" 
                              FontSize="12"
                              Opacity="0.7"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Compose Post -->
      <Border Background="White" 
              CornerRadius="8" 
              Padding="0"
              BoxShadow="0 1 3 0 #19000000">
        
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          
          <!-- Header -->
          <Grid Grid.Row="0" Margin="20,20,20,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="Compose Post" 
                       FontSize="20" 
                       FontWeight="SemiBold"
                       Foreground="#4F46E5"
                       VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" 
                       Orientation="Horizontal" 
                       Spacing="16"
                       VerticalAlignment="Center">
              
              <!-- Thread Mode Toggle -->
              <StackPanel Orientation="Horizontal" 
                         Spacing="8" 
                         IsVisible="{Binding ThreadSupported}">
                <ToggleSwitch IsChecked="{Binding IsThread}"
                             IsEnabled="{Binding !ThreadsOnlyMode}"
                             OnContent="Thread"
                             OffContent="Thread"/>
              </StackPanel>
              
              <!-- Threads Only Mode Indicator -->
              <Border IsVisible="{Binding ThreadsOnlyMode}"
                     Background="#E0E7FF"
                     CornerRadius="4"
                     Padding="8,4">
                <TextBlock Text="Threads Only Mode" 
                          FontSize="12" 
                          FontWeight="Medium"
                          Foreground="#4F46E5"/>
              </Border>
              
              <!-- Promo Mode Toggle -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleSwitch IsChecked="{Binding PromoMode}"
                             OnContent="Promo Mode"
                             OffContent="Promo Mode"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Tab Headers -->
          <Border Grid.Row="1" 
                  Background="#F8FAFC" 
                  CornerRadius="8,8,0,0"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1,1,1,0"
                  Margin="20,0,20,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              
              <!-- Composer Tab -->
              <Button Grid.Column="0" 
                      Content="Composer" 
                      Background="#4F46E5"
                      Foreground="White"
                      BorderThickness="0"
                      CornerRadius="6,0,0,0"
                      Padding="16,12"
                      FontWeight="Medium"/>
              
              <!-- Preview Tab -->
              <Button Grid.Column="1" 
                      Content="Preview" 
                      Background="Transparent"
                      Foreground="#6B7280"
                      BorderThickness="0"
                      CornerRadius="0,6,0,0"
                      Padding="16,12"/>
            </Grid>
          </Border>
          
          <!-- Tab Content -->
          <Border Grid.Row="2" 
                  Background="White"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1,0,1,1"
                  CornerRadius="0,0,8,8"
                  Margin="20,0,20,0">
            
            <Grid Margin="20">
              
              <!-- Composer Content -->
              <StackPanel Spacing="20">
                
                <!-- Main Post Content -->
                <StackPanel Spacing="12" IsVisible="{Binding !IsThread}">
                  <TextBlock Text="Main Post" 
                            FontSize="16" 
                            FontWeight="SemiBold"/>
                  
                  <TextBox Text="{Binding Content}" 
                          Watermark="What's happening?"
                          TextWrapping="Wrap"
                          AcceptsReturn="True"
                          MinHeight="120"
                          MaxHeight="300"
                          BorderBrush="#E5E7EB"
                          CornerRadius="6"
                          Padding="12"/>
                  
                  <!-- Media Upload for Main Post -->
                  <Border Background="#F9FAFB"
                          BorderBrush="#E5E7EB"
                          BorderThickness="2"
                          CornerRadius="6"
                          Padding="40,20"
                          MinHeight="100">
                    <StackPanel HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Spacing="8">
                      <TextBlock Text="📁 📹" 
                                FontSize="24"
                                HorizontalAlignment="Center"/>
                      <TextBlock Text="Drag and drop media here or click to browse" 
                                FontSize="14"
                                Foreground="#6B7280"
                                HorizontalAlignment="Center"/>
                      <TextBlock Text="Supports images and videos" 
                                FontSize="12"
                                Foreground="#9CA3AF"
                                HorizontalAlignment="Center"/>
                      <Button Content="📁 Upload" 
                             Command="{Binding UploadMediaCommand}"
                             Background="#4F46E5"
                             Foreground="White"
                             Padding="12,6"
                             CornerRadius="4"
                             Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
                
                <!-- Thread Posts -->
                <StackPanel Spacing="16" IsVisible="{Binding IsThread}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                              Text="Thread Posts" 
                              FontSize="16" 
                              FontWeight="SemiBold"/>
                    
                    <Button Grid.Column="1"
                           Content="➕ Add Post" 
                           Command="{Binding AddThreadPostCommand}"
                           Background="#10B981"
                           Foreground="White"
                           Padding="12,6"
                           CornerRadius="4"/>
                  </Grid>
                  
                  <!-- Thread Posts List -->
                  <ItemsControl ItemsSource="{Binding ThreadPosts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#F8FAFC"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="6"
                               Padding="16"
                               Margin="0,0,0,12">
                          
                          <Grid RowDefinitions="Auto,Auto,Auto">
                            
                            <!-- Post Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              
                              <TextBlock Grid.Column="0"
                                        Text="{Binding OrderIndex, StringFormat='Post {0}'}" 
                                        FontWeight="Medium"
                                        Foreground="#374151"/>
                              
                              <StackPanel Grid.Column="1" 
                                         Orientation="Horizontal" 
                                         Spacing="4">
                                <Button Content="⬆️" 
                                       Command="{Binding $parent[UserControl].((vm:PostEditorViewModel)DataContext).MoveThreadPostUpCommand}"
                                       CommandParameter="{Binding}"
                                       Width="32" Height="32"
                                       Padding="0"
                                       Background="Transparent"
                                       BorderThickness="1"
                                       BorderBrush="#D1D5DB"
                                       CornerRadius="4"/>
                                <Button Content="⬇️" 
                                       Command="{Binding $parent[UserControl].((vm:PostEditorViewModel)DataContext).MoveThreadPostDownCommand}"
                                       CommandParameter="{Binding}"
                                       Width="32" Height="32"
                                       Padding="0"
                                       Background="Transparent"
                                       BorderThickness="1"
                                       BorderBrush="#D1D5DB"
                                       CornerRadius="4"/>
                                <Button Content="🗑️" 
                                       Command="{Binding $parent[UserControl].((vm:PostEditorViewModel)DataContext).RemoveThreadPostCommand}"
                                       CommandParameter="{Binding}"
                                       Width="32" Height="32"
                                       Padding="0"
                                       Background="#EF4444"
                                       Foreground="White"
                                       BorderThickness="0"
                                       CornerRadius="4"/>
                              </StackPanel>
                            </Grid>
                            
                            <!-- Post Content -->
                            <TextBox Grid.Row="1"
                                    Text="{Binding Content}" 
                                    Watermark="Add your content..."
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    MinHeight="80"
                                    BorderBrush="#E5E7EB"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,12"/>
                            
                            <!-- Thread Post Media Upload -->
                            <Border Grid.Row="2"
                                   Background="White"
                                   BorderBrush="#E5E7EB"
                                   BorderThickness="2"
                                   CornerRadius="4"
                                   Padding="20,12"
                                   MinHeight="60">
                              <StackPanel HorizontalAlignment="Center" 
                                         VerticalAlignment="Center"
                                         Spacing="4">
                                <TextBlock Text="📁 📹" 
                                          FontSize="16"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag and drop media here or click to browse" 
                                          FontSize="12"
                                          Foreground="#6B7280"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Supports images and videos" 
                                          FontSize="10"
                                          Foreground="#9CA3AF"
                                          HorizontalAlignment="Center"/>
                                <Button Content="📁 Upload" 
                                       Background="#4F46E5"
                                       Foreground="White"
                                       Padding="8,4"
                                       CornerRadius="4"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                              </StackPanel>
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          
          <!-- Footer with Hashtags and Actions -->
          <StackPanel Grid.Row="3" Margin="20" Spacing="20">
            
            <!-- Hashtags Section -->
            <StackPanel Spacing="12">
              <TextBlock Text="Hashtags" 
                        FontSize="14" 
                        FontWeight="SemiBold"
                        Foreground="#374151"/>
              <TextBlock Text="Add hashtags to increase discoverability (shown in promo mode only)" 
                        FontSize="12"
                        Foreground="#6B7280"/>
              
              <!-- Hashtag Display -->
              <ItemsControl ItemsSource="{Binding Hashtags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#E0E7FF"
                           CornerRadius="12"
                           Padding="8,4"
                           Margin="0,0,6,6">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding, StringFormat='#{0}'}" 
                                  FontSize="12"
                                  Foreground="#4F46E5"/>
                        <Button Content="✖" 
                               Command="{Binding $parent[UserControl].((vm:PostEditorViewModel)DataContext).RemoveHashtagCommand}"
                               CommandParameter="{Binding}"
                               Width="16" Height="16"
                               Padding="0"
                               FontSize="10"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="#6B7280"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              
              <!-- Add Hashtag -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding NewHashtag}" 
                        Watermark="Add hashtag..."
                        BorderBrush="#E5E7EB"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                       Content="Add" 
                       Command="{Binding AddHashtagCommand}"
                       Background="#4F46E5"
                       Foreground="White"
                       Padding="16,8"
                       CornerRadius="4"/>
              </Grid>
            </StackPanel>
            
            <!-- Action Buttons -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              
              <TextBlock Grid.Column="0"
                        Text="{Binding SelectedPlatforms.Count, StringFormat='Posting to {0} platforms'}"
                        VerticalAlignment="Center"
                        Foreground="#6B7280"/>
              
              <StackPanel Grid.Column="1" 
                         Orientation="Horizontal" 
                         Spacing="8">
                <Button Content="💾 Save Draft" 
                       Command="{Binding SaveDraftCommand}"
                       Background="Transparent"
                       BorderBrush="#D1D5DB"
                       BorderThickness="1"
                       Padding="16,8"
                       CornerRadius="4"/>
                
                <Button Background="#06B6D4"
                       Foreground="White"
                       BorderThickness="0"
                       Padding="20,8"
                       CornerRadius="4"
                       FontWeight="SemiBold"
                       Command="{Binding PostCommand}"
                       IsEnabled="{Binding !IsPosting}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🚀" FontSize="14"/>
                    <TextBlock Text="Post" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl> 