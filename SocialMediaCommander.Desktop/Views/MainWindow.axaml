<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SocialMediaCommander.Desktop.ViewModels"
        xmlns:views="using:SocialMediaCommander.Desktop.Views"
        x:Class="SocialMediaCommander.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Social Media Commander"
        MinWidth="1280" MinHeight="800"
        Background="{DynamicResource SMC-Background}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <!-- Page Transition Animations -->
        <Style Selector="TransitioningContentControl">
            <Setter Property="PageTransition">
                <CrossFade Duration="0:0:0.3"/>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Clean Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource SMC-Accent}" 
                BorderBrush="{DynamicResource SMC-Accent}" 
                BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- App Title (Draggable Area) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            PointerPressed="OnTitleBarPointerPressed">
                    <Border Background="{DynamicResource SMC-Accent-Foreground}" 
                            CornerRadius="6" Padding="4" Opacity="0.1">
                        <TextBlock Text="🚀" FontSize="20"/>
                    </Border>
                    <TextBlock Text="Social Media Commander" 
                               Foreground="{DynamicResource SMC-Accent-Foreground}" 
                               FontWeight="Bold" FontSize="18"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Draggable Area -->
                <Border Grid.Column="1" Background="Transparent" 
                        PointerPressed="OnTitleBarPointerPressed"
                        Cursor="Hand"
                        ToolTip.Tip="Drag to move window"/>
            </Grid>
        </Border>

        <!-- Main Content Area with Persistent Sidebar -->
        <SplitView Grid.Row="1" 
                   IsPaneOpen="{Binding IsSidebarOpen}"
                   DisplayMode="CompactInline"
                   CompactPaneLength="60"
                   OpenPaneLength="220"
                   PanePlacement="Left">
            
            <!-- Persistent Sidebar Navigation - ALWAYS VISIBLE -->
            <SplitView.Pane>
                <Border Background="{DynamicResource SMC-Muted}" 
                        BorderBrush="{DynamicResource SMC-Card-Border}" 
                        BorderThickness="0,0,1,0">
                    <StackPanel Spacing="8" Margin="0,12">
                        <!-- Toggle Sidebar Button -->
                        <Button Command="{Binding ToggleSidebarCommand}"
                                ToolTip.Tip="Toggle Sidebar"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Classes="ghost"
                                Margin="8,0"
                                Height="44">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="☰" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Menu" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarOpen}"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="8,4"/>

                        <!-- Home Navigation Button -->
                        <Button Command="{Binding NavigateToHomeCommand}"
                                ToolTip.Tip="Home"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Classes="ghost"
                                Height="44"
                                Margin="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{DynamicResource SMC-Accent}"
                                        IsVisible="{Binding IsHomeView}">
                                    <TextBlock Text="🏠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="🏠" FontSize="18" VerticalAlignment="Center" IsVisible="{Binding !IsHomeView}"/>
                                <TextBlock Text="Home" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarOpen}"/>
                            </StackPanel>
                        </Button>

                        <!-- AI Assistant Navigation Button -->
                        <Button Command="{Binding ToggleAIAssistantCommand}"
                                ToolTip.Tip="AI Assistant"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Classes="ghost"
                                Height="44"
                                Margin="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{DynamicResource SMC-Accent}"
                                        IsVisible="{Binding IsAIAssistantVisible}">
                                    <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="🤖" FontSize="18" VerticalAlignment="Center" IsVisible="{Binding !IsAIAssistantVisible}"/>
                                <TextBlock Text="AI Assistant" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarOpen}"/>
                            </StackPanel>
                        </Button>

                        <!-- Scheduler Navigation Button -->
                        <Button Command="{Binding ToggleSchedulerCommand}"
                                ToolTip.Tip="Schedule Posts"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Classes="ghost"
                                Height="44"
                                Margin="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{DynamicResource SMC-Accent}"
                                        IsVisible="{Binding IsSchedulerVisible}">
                                    <TextBlock Text="📅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="📅" FontSize="18" VerticalAlignment="Center" IsVisible="{Binding !IsSchedulerVisible}"/>
                                <TextBlock Text="Scheduler" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarOpen}"/>
                            </StackPanel>
                        </Button>

                        <!-- Documentation Navigation Button -->
                        <Button Command="{Binding ToggleDocumentationCommand}"
                                ToolTip.Tip="Documentation"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Classes="ghost"
                                Height="44"
                                Margin="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{DynamicResource SMC-Accent}"
                                        IsVisible="{Binding IsDocumentationVisible}">
                                    <TextBlock Text="📖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="📖" FontSize="18" VerticalAlignment="Center" IsVisible="{Binding !IsDocumentationVisible}"/>
                                <TextBlock Text="Documentation" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarOpen}"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings Navigation Button -->
                        <Button Command="{Binding ToggleSettingsCommand}"
                                ToolTip.Tip="Settings"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Classes="ghost"
                                Height="44"
                                Margin="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{DynamicResource SMC-Accent}"
                                        IsVisible="{Binding IsSettingsVisible}">
                                    <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="⚙️" FontSize="18" VerticalAlignment="Center" IsVisible="{Binding !IsSettingsVisible}"/>
                                <TextBlock Text="Settings" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarOpen}"/>
                            </StackPanel>
                        </Button>

                        <!-- Manage Accounts Navigation Button -->
                        <Button Command="{Binding ManageAccountsCommand}"
                                ToolTip.Tip="Manage Accounts"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Classes="ghost"
                                Height="44"
                                Margin="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{DynamicResource SMC-Accent}"
                                        IsVisible="{Binding IsAccountManagerVisible}">
                                    <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" IsVisible="{Binding !IsAccountManagerVisible}"/>
                                <TextBlock Text="Manage Accounts" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarOpen}"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="8,4"/>

                        <!-- View Mode Section (When Expanded) -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSidebarOpen}" Margin="8,4,8,0">
                            <TextBlock Text="View Mode" 
                                       FontSize="12" 
                                       Opacity="0.7" 
                                       Margin="4,0"/>
                            <StackPanel Spacing="4">
                                <ToggleButton Content="Standard View" 
                                              IsChecked="{Binding !IsCompactViewActive}"
                                              Command="{Binding SetStandardViewCommand}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              FontSize="13"
                                              ToolTip.Tip="Switch to standard view layout"/>
                                <ToggleButton Content="Compact View" 
                                              IsChecked="{Binding IsCompactViewActive}"
                                              Command="{Binding SetCompactViewCommand}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              FontSize="13"
                                              ToolTip.Tip="Switch to compact side-by-side view"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Workspace Mode Section (When Expanded) -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSidebarOpen}" Margin="8,4,8,0">
                            <TextBlock Text="Workspace Mode" 
                                       FontSize="12" 
                                       Opacity="0.7" 
                                       Margin="4,0"/>
                            <StackPanel Spacing="4">
                                <ToggleButton Content="Single/Thread Posts" 
                                              Command="{Binding SetSingleThreadModeCommand}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              FontSize="13"
                                              ToolTip.Tip="Compose single posts or threads"/>
                                <ToggleButton Content="Threads Only" 
                                              Command="{Binding SetThreadsOnlyModeCommand}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              FontSize="13"
                                              ToolTip.Tip="Focus on thread composition"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </SplitView.Pane>

            <!-- Main Content Area with Page Transitions -->
            <SplitView.Content>
                <Grid RowDefinitions="Auto,*">
                    <!-- Header Bar with Breadcrumbs (hidden on overlay pages with their own headers) -->
                    <views:HeaderBarView Grid.Row="0" DataContext="{Binding}"
                                        IsVisible="{Binding IsHomeView}"/>
                    
                    <!-- Content Area with Page-Based Rendering -->
                    <Grid Grid.Row="1">
                        <!-- Home View -->
                        <Grid IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavigationPage.Home}}"
                              Margin="16"
                              Classes="PageTransition FadeIn">
            <!-- Standard View Layout -->
            <ScrollViewer IsVisible="{Binding !IsCompactViewActive}" Padding="0,0,8,0">
                <StackPanel Spacing="16" MaxWidth="1200">
                    <!-- Success Message (when visible) -->
                    <Border Background="{DynamicResource SMC-Success-Background}"
                            BorderBrush="{DynamicResource SMC-Success-Border}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                            BoxShadow="0 2 6 0 #10059669" Classes="FadeIn SuccessCheckmark"
                            IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{DynamicResource SMC-Success}" 
                                    CornerRadius="16" Padding="6">
                                <TextBlock Text="🚀" FontSize="16" 
                                           Foreground="{DynamicResource SMC-Success-Foreground}"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Post published successfully!" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource SMC-Success-Foreground}"/>
                                <TextBlock Text="Your content is now live on your selected platforms." 
                                           FontSize="14" Opacity="0.8"
                                           Foreground="{DynamicResource SMC-Success-Foreground}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Post Editor Card -->
                    <Border Background="{DynamicResource SMC-Card-Background}"
                            BorderBrush="{DynamicResource SMC-Card-Border}" BorderThickness="1"
                            CornerRadius="8" Padding="16" BoxShadow="0 2 4 0 #10000000"
                            Classes="SlideInBottom">
                        <views:PostEditorView DataContext="{Binding PostEditor}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Compact View Layout -->
            <Grid IsVisible="{Binding IsCompactViewActive}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding PostEditorColumnWidth}"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="{Binding FeedColumnWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Post Editor Column -->
                <ScrollViewer Grid.Column="0" Padding="0,0,8,0">
                    <Border Background="{DynamicResource SMC-Card-Background}"
                            BorderBrush="{DynamicResource SMC-Card-Border}" BorderThickness="1"
                            CornerRadius="8" Padding="16" BoxShadow="0 2 4 0 #10000000"
                            Classes="SlideInBottom">
                        <views:PostEditorView DataContext="{Binding PostEditor}"/>
                    </Border>
                </ScrollViewer>

                <!-- Social Feed Column -->
                <ScrollViewer Grid.Column="2" Padding="8,0,0,0" 
                              IsVisible="{Binding !IsComposeOnlyActive}">
                    <Border Background="{DynamicResource SMC-Card-Background}"
                            BorderBrush="{DynamicResource SMC-Card-Border}" BorderThickness="1"
                            CornerRadius="8" Padding="16" BoxShadow="0 2 4 0 #10000000"
                            Classes="SlideInBottom">
                        <views:SocialFeedView DataContext="{Binding SocialFeed}"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
            
            <!-- Account Manager Page -->
            <Grid IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavigationPage.AccountManager}}"
                  Margin="16"
                  Classes="PageTransition SlideInRight">
                <views:AccountManagerView DataContext="{Binding AccountManager}"/>
            </Grid>
            
            <!-- Settings Page -->
            <Grid IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavigationPage.Settings}}"
                  Margin="16"
                  Classes="PageTransition SlideInRight">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </Grid>
            
            <!-- AI Assistant Page -->
            <Grid IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavigationPage.AIAssistant}}"
                  Margin="16"
                  Classes="PageTransition SlideInRight">
                <views:AIAssistantView DataContext="{Binding AIAssistant}"/>
            </Grid>
            
            <!-- Scheduler Page -->
            <Grid IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavigationPage.Scheduler}}"
                  Margin="16"
                  Classes="PageTransition SlideInRight">
                <views:SchedulerView DataContext="{Binding Scheduler}"/>
            </Grid>
            
            <!-- Documentation Page -->
            <Grid IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavigationPage.Documentation}}"
                  Margin="16"
                  Classes="PageTransition SlideInRight">
                <views:DocumentationView DataContext="{Binding Documentation}"/>
            </Grid>
        </Grid>
                </Grid>
            </SplitView.Content>
        </SplitView>        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SMC-Muted}"
                BorderBrush="{DynamicResource SMC-Card-Border}" 
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Social Media Management Hub — A unified platform for all your social media needs" 
                           FontSize="14" 
                           Foreground="{DynamicResource SMC-Muted-Foreground}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="❓" Classes="ghost" 
                            Width="36" Height="36" 
                            FontSize="16"
                            ToolTip.Tip="Help &amp; Support"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
