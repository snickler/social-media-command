<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             x:Class="SocialMediaCommander.Desktop.App"
             xmlns:local="using:SocialMediaCommander.Desktop"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <ResourceDictionary>
            <!-- Modern Spacing System (4px/8px/12px/16px increments) -->
            <System:Double x:Key="SpacingTiny">4</System:Double>
            <System:Double x:Key="SpacingSmall">8</System:Double>
            <System:Double x:Key="SpacingMedium">12</System:Double>
            <System:Double x:Key="SpacingLarge">16</System:Double>
            
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Base -->
                    <Color x:Key="SMC-Background">#f5f6fa</Color>
                    <Color x:Key="SMC-Foreground">#2e2d33</Color>

                    <!-- Primary/Accent (Indigo 700) -->
                    <Color x:Key="SMC-Accent">#4338CA</Color>
                    <Color x:Key="SMC-Accent-Foreground">#f5f6fa</Color>
                    <Color x:Key="SMC-Accent-Hover">#5a52d0</Color>
                    <Color x:Key="SMC-Accent-Pressed">#716dd6</Color>
                    
                    <!-- Surface Layers (2025 elevation system) -->
                    <Color x:Key="SMC-Surface-0">#ffffff</Color>
                    <Color x:Key="SMC-Surface-1">#f7f8fc</Color>
                    <Color x:Key="SMC-Surface-2">#eef1f7</Color>
                    <Color x:Key="SMC-Surface-3">#e5e9f0</Color>
                    
                    <!-- Text Hierarchy -->
                    <Color x:Key="SMC-Text-Primary">#1a1b26</Color>
                    <Color x:Key="SMC-Text-Secondary">#4a5568</Color>
                    <Color x:Key="SMC-Text-Tertiary">#6c757d</Color>
                    <Color x:Key="SMC-Text-Disabled">#a0aec0</Color>
                    
                    <!-- Border Variants -->
                    <Color x:Key="SMC-Border-Subtle">#e5e9f0</Color>
                    <Color x:Key="SMC-Border-Default">#dedce3</Color>
                    <Color x:Key="SMC-Border-Strong">#c4c4cc</Color>
                    <Color x:Key="SMC-Border-Active">#4338CA</Color>

                    <!-- Destructive -->
                    <Color x:Key="SMC-Destructive">#f04141</Color>
                    <Color x:Key="SMC-Destructive-Hover">#e13333</Color>
                    <Color x:Key="SMC-Destructive-Pressed">#d12121</Color>
                    <Color x:Key="SMC-Destructive-Foreground">#f5f6fa</Color>

                    <!-- Card -->
                    <Color x:Key="SMC-Card-Background">#f7f8fc</Color>
                    <Color x:Key="SMC-Card-Border">#dedce3</Color>

                    <!-- Muted -->
                    <Color x:Key="SMC-Muted">#f1f2f6</Color>
                    <Color x:Key="SMC-Muted-Foreground">#6c757d</Color>

                    <!-- Status -->
                    <Color x:Key="SMC-Warning-Background">#FEF3C7</Color>
                    <Color x:Key="SMC-Warning-Border">#B45309</Color>
                    <Color x:Key="SMC-Success">#059669</Color>
                    <Color x:Key="SMC-Success-Background">#DCFCE7</Color>
                    <Color x:Key="SMC-Success-Border">#059669</Color>
                    <Color x:Key="SMC-Success-Foreground">#065f46</Color>

                    <!-- Secondary Button -->
                    <Color x:Key="SMC-Secondary-Background">#EBEAFB</Color>
                    <Color x:Key="SMC-Secondary-Foreground">#4338CA</Color>
                    <Color x:Key="SMC-Secondary-Hover">#DCD9F7</Color>
                    <Color x:Key="SMC-Secondary-Pressed">#CEC9F3</Color>

                    <!-- Overriding Fluent Colors -->
                    <Color x:Key="SystemAccentColor">#4338CA</Color>
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Dark">
                    <!-- Base - Dark slate background with light foreground -->
                    <Color x:Key="SMC-Background">#1a1b26</Color>
                    <Color x:Key="SMC-Foreground">#e0e0e6</Color>

                    <!-- Primary/Accent - Brighter indigo for dark mode -->
                    <Color x:Key="SMC-Accent">#7c73e6</Color>
                    <Color x:Key="SMC-Accent-Foreground">#ffffff</Color>
                    <Color x:Key="SMC-Accent-Hover">#9990ff</Color>
                    <Color x:Key="SMC-Accent-Pressed">#5e54d9</Color>
                    
                    <!-- Surface Layers (2025 dark elevation) -->
                    <Color x:Key="SMC-Surface-0">#16161e</Color>
                    <Color x:Key="SMC-Surface-1">#24283b</Color>
                    <Color x:Key="SMC-Surface-2">#2d3250</Color>
                    <Color x:Key="SMC-Surface-3">#363d5e</Color>
                    
                    <!-- Text Hierarchy -->
                    <Color x:Key="SMC-Text-Primary">#e0e0e6</Color>
                    <Color x:Key="SMC-Text-Secondary">#a9b1d6</Color>
                    <Color x:Key="SMC-Text-Tertiary">#9aa5ce</Color>
                    <Color x:Key="SMC-Text-Disabled">#565f89</Color>
                    
                    <!-- Border Variants -->
                    <Color x:Key="SMC-Border-Subtle">#2d3250</Color>
                    <Color x:Key="SMC-Border-Default">#414868</Color>
                    <Color x:Key="SMC-Border-Strong">#565f89</Color>
                    <Color x:Key="SMC-Border-Active">#7c73e6</Color>

                    <!-- Destructive - Softer red for dark mode -->
                    <Color x:Key="SMC-Destructive">#f87171</Color>
                    <Color x:Key="SMC-Destructive-Hover">#fc8181</Color>
                    <Color x:Key="SMC-Destructive-Pressed">#ef4444</Color>
                    <Color x:Key="SMC-Destructive-Foreground">#ffffff</Color>

                    <!-- Card - Elevated surface -->
                    <Color x:Key="SMC-Card-Background">#24283b</Color>
                    <Color x:Key="SMC-Card-Border">#414868</Color>

                    <!-- Muted - Subtle background -->
                    <Color x:Key="SMC-Muted">#1f2335</Color>
                    <Color x:Key="SMC-Muted-Foreground">#9aa5ce</Color>

                    <!-- Status - Dark mode friendly colors -->
                    <Color x:Key="SMC-Warning-Background">#3d2e1f</Color>
                    <Color x:Key="SMC-Warning-Border">#f59e0b</Color>
                    <Color x:Key="SMC-Success">#34d399</Color>
                    <Color x:Key="SMC-Success-Background">#1a3a2e</Color>
                    <Color x:Key="SMC-Success-Border">#10b981</Color>
                    <Color x:Key="SMC-Success-Foreground">#d1fae5</Color>

                    <!-- Secondary Button -->
                    <Color x:Key="SMC-Secondary-Background">#2d2a4a</Color>
                    <Color x:Key="SMC-Secondary-Foreground">#9990ff</Color>
                    <Color x:Key="SMC-Secondary-Hover">#3d3858</Color>
                    <Color x:Key="SMC-Secondary-Pressed">#252238</Color>

                    <!-- Overriding Fluent Colors -->
                    <Color x:Key="SystemAccentColor">#7c73e6</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/AnimationsAndTransitions.axaml"/>

        <!-- Primary Button Styles -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent-Hover}"/>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent-Pressed}"/>
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Button.primary:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Secondary Button Styles -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SMC-Secondary-Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Secondary-Foreground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Secondary-Background-Hover}"/>
        </Style>
        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="{DynamicResource SMC-Secondary-Background-Pressed}"/>
        </Style>
        <Style Selector="Button.secondary:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.secondary:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        
        <!-- Outline Button Style -->
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.outline:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
        </Style>
        <Style Selector="Button.outline:pressed">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent-Pressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
        </Style>
        <Style Selector="Button.outline:focus-visible">
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="Button.outline:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Ghost Button Style -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{DynamicResource SMC-Muted}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Foreground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
        </Style>
        <Style Selector="Button.ghost:pressed">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
        </Style>
        <Style Selector="Button.ghost:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Destructive Button -->
        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="{DynamicResource SMC-Destructive}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Destructive-Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Destructive}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.destructive:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Destructive-Hover}"/>
        </Style>
        <Style Selector="Button.destructive:pressed">
            <Setter Property="Background" Value="{DynamicResource SMC-Destructive-Pressed}"/>
        </Style>
        <Style Selector="Button.destructive:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Destructive-Foreground}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.destructive:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- ToggleButton Styles -->
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SMC-Muted}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
        </Style>
        <Style Selector="ToggleButton:checked">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ToggleButton:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent-Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent-Hover}"/>
        </Style>
        <Style Selector="ToggleButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent-Pressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
        </Style>
        <Style Selector="ToggleButton:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        
        <!-- Tab Button -->
        <Style Selector="RadioButton.TabButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="RadioButton.TabButton:checked">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Margin" Value="0,0,0,-1"/>
             <Setter Property="Panel.ZIndex" Value="1"/>
        </Style>
         <Style Selector="RadioButton.TabButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
        </Style>

        <!-- TextBox Style -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource SMC-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="TextBox.modern">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- ComboBox Style -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SMC-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ComboBox.modern">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
        </Style>

        <!-- Card Styles -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BoxShadow" Value="0 2 4 0 #10000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Border.card:pointerover">
            <Setter Property="BoxShadow" Value="0 4 8 0 #15000000"/>
        </Style>
        
        <Style Selector="Border.card-interactive">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #10000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Border.card-interactive:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #154338CA"/>
        </Style>

        <Style Selector="Border.status-info">
            <Setter Property="Background" Value="{DynamicResource SMC-Card-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Card-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Border.status-warning">
            <Setter Property="Background" Value="{DynamicResource SMC-Warning-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Warning-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Border.status-success">
            <Setter Property="Background" Value="{DynamicResource SMC-Success-Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Success-Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        
        <!-- Badge Styles -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        
        <Style Selector="Border.badge.success">
            <Setter Property="Background" Value="{DynamicResource SMC-Success}"/>
        </Style>
        
        <Style Selector="Border.badge.warning">
            <Setter Property="Background" Value="#F59E0B"/>
        </Style>
        
        <Style Selector="Border.badge.error">
            <Setter Property="Background" Value="{DynamicResource SMC-Destructive}"/>
        </Style>
        
        <Style Selector="Border.badge.accent">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent}"/>
        </Style>
        
        <Style Selector="Border.badge TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        
        <!-- Smooth Transitions Class -->
        <Style Selector="Border.SmoothTransitions">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <ThicknessTransition Property="BorderThickness" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        
        <!-- Page Transition Animations (Opacity only - no RenderTransform) -->
        <Style Selector="Grid.PageTransition">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Grid.SlideInRight">
            <Style.Animations>
                <Animation Duration="0:0:0.4" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        
        <!-- ToggleButton Styles -->
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton:checked">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton:pressed">
            <Setter Property="Background" Value="#e8e9f0"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent}"/>
        </Style>
        <Style Selector="ToggleButton:focus-visible">
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <!-- Sidebar Navigation Active State -->
        <Style Selector="Button.sidebar-active">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SMC-Accent-Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.sidebar-active:pointerover">
            <Setter Property="Background" Value="{DynamicResource SMC-Accent-Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SMC-Accent-Hover}"/>
        </Style>
    </Application.Styles>
</Application>